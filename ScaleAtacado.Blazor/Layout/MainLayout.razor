@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject CompanyService CompanyService
@inject CompanyStateService CompanyState

<MudThemeProvider Theme="AppTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Primary" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
            Edge="Edge.Start" OnClick="ToggleDrawer" />

        <!-- Logo -->
        <div class="d-flex align-center ml-1 gap-2">
            <img src="logo.png" alt="ScaleAtacado" class="appbar-logo" />
            <MudText Typo="Typo.h6" Style="font-weight:800;letter-spacing:-0.5px;color:white;line-height:1">
                SCALE<span style="font-weight:300;opacity:0.75">atacado</span>
            </MudText>
        </div>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <MudText Class="mr-2 d-none d-sm-flex" Typo="Typo.body2" Style="color:rgba(255,255,255,0.85)">
                    @context.User.FindFirst("fullName")?.Value
                </MudText>
                <span class="mr-3" style="background:rgba(255,255,255,0.14);color:white;font-size:0.65rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:3px 9px;border-radius:5px;border:1px solid rgba(255,255,255,0.25)">
                    @(context.User.FindFirst("profile")?.Value switch { "Admin" => "Admin", "Attendant" => "Atendente", var v => v })
                </span>
                <MudTooltip Text="Sair">
                    <MudIconButton Icon="@Icons.Material.Filled.Logout"
                        Color="Color.Inherit" OnClick="LogoutAsync" />
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive">
        <div class="d-flex align-center" style="padding:12px 16px;gap:10px;border-bottom:1px solid rgba(0,0,0,0.08);min-height:58px">
            @if (!string.IsNullOrEmpty(CompanyState.LogoBase64))
            {
                <img src="@CompanyState.LogoBase64"
                     style="width:40px;height:40px;object-fit:contain;border-radius:6px;flex-shrink:0" />
                <div style="line-height:1.25;overflow:hidden">
                    <div style="font-weight:700;font-size:0.82rem;color:#0D1B4B;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                        @CompanyState.CompanyName
                    </div>
                    <div style="font-weight:400;font-size:0.65rem;color:#1565C0;letter-spacing:0.08em;text-transform:uppercase">
                        SCALEatacado
                    </div>
                </div>
            }
            else
            {
                <img src="logo.png" alt="ScaleAtacado" class="drawer-logo" />
            }
        </div>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4 pt-2">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        CompanyState.OnChange += StateHasChanged;
        var resp = await CompanyService.GetAsync();
        if (resp?.Success == true && resp.Data != null)
            CompanyState.Set(resp.Data.Name, resp.Data.LogoBase64);
    }

    public void Dispose() => CompanyState.OnChange -= StateHasChanged;

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        NavManager.NavigateTo("/login");
    }
}
