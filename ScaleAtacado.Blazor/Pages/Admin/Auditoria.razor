@page "/admin/auditoria"
@attribute [Authorize(Roles = "Admin")]
@inject AuditoriaService AuditoriaService
@inject ISnackbar Snackbar

<PageTitle>Auditoria — ScaleAtacado</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Log de Auditoria</MudText>
</div>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudDatePicker @bind-Date="_de" Label="De" Variant="Variant.Outlined"
                DateFormat="dd/MM/yyyy" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker @bind-Date="_ate" Label="Até" Variant="Variant.Outlined"
                DateFormat="dd/MM/yyyy" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                OnClick="CarregarAsync" StartIcon="@Icons.Material.Filled.Search"
                Disabled="_carregando">
                Filtrar
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="_registros" Dense="true" Hover="true" Striped="true" Loading="_carregando"
    FixedHeader="true" Height="600px">
    <HeaderContent>
        <MudTh>Data/Hora</MudTh>
        <MudTh>Operação</MudTh>
        <MudTh>Entidade</MudTh>
        <MudTh>ID Entidade</MudTh>
        <MudTh Style="text-align:center">Detalhes</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Data">@context.DataHora.ToString("dd/MM/yy HH:mm:ss")</MudTd>
        <MudTd DataLabel="Operação">
            <MudChip T="string" Size="Size.Small" Color="@GetOperacaoColor(context.Operacao)">
                @context.Operacao
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Entidade">@context.EntidadeNome</MudTd>
        <MudTd DataLabel="ID">
            <MudText Typo="Typo.caption" Style="font-family:monospace">
                @(context.EntidadeId?.Length > 8 ? context.EntidadeId[..8] + "..." : context.EntidadeId ?? "—")
            </MudText>
        </MudTd>
        <MudTd Style="text-align:center">
            @if (!string.IsNullOrEmpty(context.ValorAnterior) || !string.IsNullOrEmpty(context.ValorNovo))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small"
                    OnClick="@(() => VerDetalhes(context))" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (!_buscou)
        {
            <MudText>Selecione um período e clique em Filtrar.</MudText>
        }
        else
        {
            <MudText>Nenhum registro encontrado.</MudText>
        }
    </NoRecordsContent>
    <LoadingContent>Carregando...</LoadingContent>
</MudTable>

<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
    @_registros.Count registro(s) exibido(s)
</MudText>

<!-- Dialog: Detalhes -->
<MudDialog @bind-Visible="_dialogDetalhes" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>Detalhes da Operação</TitleContent>
    <DialogContent>
        @if (_selecionado != null)
        {
            <MudGrid Class="mb-3">
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Data</MudText>
                    <MudText>@_selecionado.DataHora.ToString("dd/MM/yyyy HH:mm:ss")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Operação</MudText>
                    <MudText>@_selecionado.Operacao — @_selecionado.EntidadeNome</MudText>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_selecionado.ValorAnterior))
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">Valor Anterior:</MudText>
                <MudPaper Class="pa-2 mb-3" Style="background:#f5f5f5; overflow:auto; max-height:200px">
                    <pre style="font-size:12px; white-space:pre-wrap">@_selecionado.ValorAnterior</pre>
                </MudPaper>
            }

            @if (!string.IsNullOrEmpty(_selecionado.ValorNovo))
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">Valor Novo:</MudText>
                <MudPaper Class="pa-2" Style="background:#f5f5f5; overflow:auto; max-height:200px">
                    <pre style="font-size:12px; white-space:pre-wrap">@_selecionado.ValorNovo</pre>
                </MudPaper>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogDetalhes = false)">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<AuditoriaResponseDto> _registros = new();
    private bool _carregando;
    private bool _buscou;
    private bool _dialogDetalhes;
    private AuditoriaResponseDto? _selecionado;
    private DateTime? _de = DateTime.Today.AddDays(-7);
    private DateTime? _ate = DateTime.Today;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _carregando = true;
        _buscou = true;
        var resp = await AuditoriaService.GetAllAsync(_de, _ate);
        _registros = resp?.Data?.OrderByDescending(r => r.DataHora).ToList() ?? new();
        _carregando = false;
    }

    private void VerDetalhes(AuditoriaResponseDto r)
    {
        _selecionado = r;
        _dialogDetalhes = true;
    }

    private static Color GetOperacaoColor(string operacao) => operacao?.ToUpper() switch
    {
        "CREATE" or "INSERT" or "CRIAR" => Color.Success,
        "UPDATE" or "ATUALIZAR" or "EDIT" => Color.Info,
        "DELETE" or "DELETAR" or "EXCLUIR" or "DESATIVAR" => Color.Error,
        _ => Color.Default
    };
}
