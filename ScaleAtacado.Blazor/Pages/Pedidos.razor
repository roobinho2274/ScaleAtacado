@page "/pedidos"
@attribute [Authorize]
@inject OrderService OrderService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject CustomerService CustomerService
@inject PaymentMethodService PaymentMethodService

<PageTitle>Pedidos — ScaleAtacado</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Pedidos</MudText>
</div>

<!-- Filtros -->
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudSelect T="DeliveryStatus?" Label="Status Entrega" @bind-Value="_filterDelivery"
                Variant="Variant.Outlined" Dense="true" Clearable="true">
                <MudSelectItem T="DeliveryStatus?" Value="null">Todos</MudSelectItem>
                <MudSelectItem T="DeliveryStatus?" Value="DeliveryStatus.AwaitingPicking">Aguardando Separação</MudSelectItem>
                <MudSelectItem T="DeliveryStatus?" Value="DeliveryStatus.Picking">Em Separação</MudSelectItem>
                <MudSelectItem T="DeliveryStatus?" Value="DeliveryStatus.OutForDelivery">Saiu p/ Entrega</MudSelectItem>
                <MudSelectItem T="DeliveryStatus?" Value="DeliveryStatus.Delivered">Entregue</MudSelectItem>
                <MudSelectItem T="DeliveryStatus?" Value="DeliveryStatus.Cancelled">Cancelado</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="FinancialStatus?" Label="Status Financeiro" @bind-Value="_filterFinancial"
                Variant="Variant.Outlined" Dense="true" Clearable="true">
                <MudSelectItem T="FinancialStatus?" Value="null">Todos</MudSelectItem>
                <MudSelectItem T="FinancialStatus?" Value="FinancialStatus.Open">Em Aberto</MudSelectItem>
                <MudSelectItem T="FinancialStatus?" Value="FinancialStatus.Paid">Pago</MudSelectItem>
                <MudSelectItem T="FinancialStatus?" Value="FinancialStatus.PartiallyPaid">Parcialmente Pago</MudSelectItem>
                <MudSelectItem T="FinancialStatus?" Value="FinancialStatus.Cancelled">Cancelado</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ReloadAsync"
                StartIcon="@Icons.Material.Filled.Search" FullWidth="true">
                Filtrar
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable ServerData="ServerData" @ref="_table" Dense="true" Hover="true" Striped="true"
    RowClassFunc="GetRowClass">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="OrderListItemDto" SortLabel="numero">Nº</MudTableSortLabel></MudTh>
        <MudTh>Data</MudTh>
        <MudTh>Cliente</MudTh>
        <MudTh>Pagamento</MudTh>
        <MudTh Style="text-align:right">Total</MudTh>
        <MudTh Style="text-align:center">Entrega</MudTh>
        <MudTh Style="text-align:center">Financeiro</MudTh>
        <MudTh Style="text-align:center">Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nº"><b>#@context.OrderNumber</b></MudTd>
        <MudTd DataLabel="Data">@context.OrderDate.ToString("dd/MM/yy HH:mm")</MudTd>
        <MudTd DataLabel="Cliente">@context.CustomerName</MudTd>
        <MudTd DataLabel="Pagamento">@context.PaymentMethodName</MudTd>
        <MudTd DataLabel="Total" Style="text-align:right">R$ @context.AmountWithSurchargeTotal.ToString("N2")</MudTd>
        <MudTd DataLabel="Entrega" Style="text-align:center">
            <MudChip T="string" Size="Size.Small" Color="@GetDeliveryColor(context.DeliveryStatus)">
                @GetDeliveryLabel(context.DeliveryStatus)
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Financeiro" Style="text-align:center">
            <MudChip T="string" Size="Size.Small" Color="@GetFinancialColor(context.FinancialStatus)">
                @GetFinancialLabel(context.FinancialStatus)
            </MudChip>
        </MudTd>
        <MudTd Style="text-align:center">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                OnClick="@(() => ViewDetailsAsync(context.Id))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>Nenhum pedido encontrado.</NoRecordsContent>
    <LoadingContent>Carregando...</LoadingContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
    </PagerContent>
</MudTable>

<!-- Dialog: Detalhes do Pedido -->
<MudDialog @bind-Visible="_dialogDetails" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        @if (_orderDetail != null)
        {
            <span>Pedido #@_orderDetail.OrderNumber — @_orderDetail.CustomerName</span>
        }
    </TitleContent>
    <DialogContent>
        @if (_orderDetail == null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            var _surchargeRate = 1 + _orderDetail.SurchargePercentage / 100m;

            <MudGrid Class="mb-3">
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Data</MudText>
                    <MudText Typo="Typo.body2">@_orderDetail.OrderDate.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Pagamento</MudText>
                    <MudText Typo="Typo.body2">@_orderDetail.PaymentMethodName</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Subtotal</MudText>
                    <MudText Typo="Typo.body2">R$ @_orderDetail.AmountTotal.ToString("N2")</MudText>
                </MudItem>
                @if (_orderDetail.SurchargePercentage > 0)
                {
                    var surchargeAmt = _orderDetail.AmountTotal * _orderDetail.SurchargePercentage / 100m;
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Acréscimo (@_orderDetail.SurchargePercentage.ToString("N1")%)</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Warning">+ R$ @surchargeAmt.ToString("N2")</MudText>
                    </MudItem>
                }
                @if (_orderDetail.DiscountAmount > 0)
                {
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Desconto</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Success">− R$ @_orderDetail.DiscountAmount.ToString("N2")</MudText>
                    </MudItem>
                }
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Final</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Primary"><b>R$ @_orderDetail.AmountWithSurchargeTotal.ToString("N2")</b></MudText>
                </MudItem>
            </MudGrid>

            <MudTable Items="_orderDetail.Items" Dense="true" Striped="true" Class="mb-2">
                <HeaderContent>
                    <MudTh>Produto</MudTh>
                    <MudTh Style="text-align:right">Preço Unit.</MudTh>
                    <MudTh Style="text-align:center">Qtd</MudTh>
                    <MudTh Style="text-align:right">Total</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ProductName</MudTd>
                    <MudTd Style="text-align:right">R$ @((context.UnitPrice * _surchargeRate).ToString("N2"))</MudTd>
                    <MudTd Style="text-align:center">@context.Quantity</MudTd>
                    <MudTd Style="text-align:right">R$ @((context.TotalPrice * _surchargeRate).ToString("N2"))</MudTd>
                </RowTemplate>
            </MudTable>
            @if (_orderDetail.SurchargePercentage > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3" Style="display:block">
                    * Preços exibidos com acréscimo de @_orderDetail.SurchargePercentage.ToString("N1")% (@_orderDetail.PaymentMethodName) já incluído.
                </MudText>
            }

            <!-- Desconto -->
            <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-divider)">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="_editDiscount" Label="Desconto (R$)"
                            Variant="Variant.Outlined" Min="0m" Format="N2"
                            HelperText="Desconto em reais aplicado ao total do pedido" />
                    </MudItem>
                    <MudItem xs="12" sm="6" Class="d-flex align-end">
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true"
                            OnClick="SaveDiscountAsync" Disabled="_saving">
                            Aplicar Desconto
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="DeliveryStatus" Label="Status de Entrega"
                        @bind-Value="_editDelivery" Variant="Variant.Outlined" Dense="true">
                        <MudSelectItem T="DeliveryStatus" Value="DeliveryStatus.AwaitingPicking">Aguardando Separação</MudSelectItem>
                        <MudSelectItem T="DeliveryStatus" Value="DeliveryStatus.Picking">Em Separação</MudSelectItem>
                        <MudSelectItem T="DeliveryStatus" Value="DeliveryStatus.OutForDelivery">Saiu para Entrega</MudSelectItem>
                        <MudSelectItem T="DeliveryStatus" Value="DeliveryStatus.Delivered">Entregue</MudSelectItem>
                        <MudSelectItem T="DeliveryStatus" Value="DeliveryStatus.Cancelled">Cancelado</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                        OnClick="SaveDeliveryAsync" Disabled="_saving">
                        Salvar Entrega
                    </MudButton>
                </MudItem>
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <!-- Alterar Forma de Pagamento -->
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2" Style="display:block">
                                ADMINISTRAÇÃO
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" sm="8">
                            <MudSelect T="Guid" Label="Forma de Pagamento" @bind-Value="_editPaymentMethodId"
                                Variant="Variant.Outlined" Dense="true"
                                ToStringFunc="@(id => _paymentMethods.FirstOrDefault(p => p.Id == id)?.Name ?? string.Empty)">
                                @foreach (var pm in _paymentMethods)
                                {
                                    <MudSelectItem T="Guid" Value="pm.Id">
                                        @pm.Name
                                        @if (pm.SurchargePercentage > 0)
                                        {
                                            <span style="color:var(--mud-palette-warning)"> (+@pm.SurchargePercentage.ToString("N1")%)</span>
                                        }
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="4" Class="d-flex align-end">
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                OnClick="SavePaymentMethodAsync" Disabled="@(_saving || _editPaymentMethodId == _orderDetail.PaymentMethodId)"
                                StartIcon="@Icons.Material.Filled.SwapHoriz">
                                Alterar Pagamento
                            </MudButton>
                        </MudItem>

                        <!-- Status Financeiro -->
                        <MudItem xs="12" sm="6">
                            <MudSelect T="FinancialStatus" Label="Status Financeiro"
                                @bind-Value="_editFinancial" Variant="Variant.Outlined" Dense="true">
                                <MudSelectItem T="FinancialStatus" Value="FinancialStatus.Open">Em Aberto</MudSelectItem>
                                <MudSelectItem T="FinancialStatus" Value="FinancialStatus.Paid">Pago</MudSelectItem>
                                <MudSelectItem T="FinancialStatus" Value="FinancialStatus.PartiallyPaid">Parcialmente Pago</MudSelectItem>
                                <MudSelectItem T="FinancialStatus" Value="FinancialStatus.Cancelled">Cancelado</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="d-flex align-end">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                OnClick="SaveFinancialAsync" Disabled="_saving">
                                Salvar Financeiro
                            </MudButton>
                        </MudItem>
                        @if (_orderDetail.IsLocked)
                        {
                            <MudItem xs="12">
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true"
                                    StartIcon="@Icons.Material.Filled.LockOpen"
                                    OnClick="UnlockAsync" Disabled="_saving">
                                    Desbloquear Pedido
                                </MudButton>
                            </MudItem>
                        }
                    </Authorized>
                </AuthorizeView>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        @if (_orderDetail != null)
        {
            <MudButton StartIcon="@Icons.Material.Filled.Print" Color="Color.Secondary"
                OnClick="PrintReceiptAsync">
                Imprimir Recibo
            </MudButton>
        }
        <MudButton OnClick="@(() => _dialogDetails = false)">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudTable<OrderListItemDto>? _table;
    private DeliveryStatus? _filterDelivery;
    private FinancialStatus? _filterFinancial;
    private bool _dialogDetails;
    private bool _saving;
    private OrderResponseDto? _orderDetail;
    private CustomerResponseDto? _customerDetail;
    private DeliveryStatus _editDelivery;
    private FinancialStatus _editFinancial;
    private decimal _editDiscount;
    private Guid _editPaymentMethodId;
    private List<PaymentMethodResponseDto> _paymentMethods = new();

    protected override async Task OnInitializedAsync()
    {
        var pmResp = await PaymentMethodService.GetAllAsync(onlyActive: true);
        _paymentMethods = pmResp?.Data?.ToList() ?? new();
    }

    private async Task<TableData<OrderListItemDto>> ServerData(TableState state, CancellationToken ct)
    {
        var resp = await OrderService.GetAllAsync(state.Page + 1, state.PageSize, _filterDelivery, _filterFinancial);
        if (resp?.Success == true && resp.Data != null)
            return new TableData<OrderListItemDto> { Items = resp.Data.Items, TotalItems = resp.Data.TotalCount };
        return new TableData<OrderListItemDto> { Items = [], TotalItems = 0 };
    }

    private async Task ReloadAsync() => await _table!.ReloadServerData();

    private async Task ViewDetailsAsync(Guid id)
    {
        _orderDetail = null;
        _customerDetail = null;
        _dialogDetails = true;

        var resp = await OrderService.GetByIdAsync(id);
        if (resp?.Success == true)
        {
            _orderDetail = resp.Data;
            _editDelivery         = _orderDetail!.DeliveryStatus;
            _editFinancial        = _orderDetail.FinancialStatus;
            _editDiscount         = _orderDetail.DiscountAmount;
            _editPaymentMethodId  = _orderDetail.PaymentMethodId;

            var customerResp = await CustomerService.GetByIdAsync(_orderDetail.CustomerId);
            _customerDetail = customerResp?.Data;
        }
        else
        {
            Snackbar.Add("Erro ao carregar pedido.", Severity.Error);
            _dialogDetails = false;
        }
    }

    private async Task SavePaymentMethodAsync()
    {
        if (_orderDetail == null || _editPaymentMethodId == _orderDetail.PaymentMethodId) return;
        _saving = true;
        var resp = await OrderService.UpdatePaymentMethodAsync(_orderDetail.Id, _editPaymentMethodId);
        if (resp?.Success == true)
        {
            Snackbar.Add("Forma de pagamento alterada e valores recalculados!", Severity.Success);
            var updated = await OrderService.GetByIdAsync(_orderDetail.Id);
            if (updated?.Success == true)
            {
                _orderDetail = updated.Data;
                _editPaymentMethodId = _orderDetail!.PaymentMethodId;
                _editDiscount        = _orderDetail.DiscountAmount;
            }
            await _table!.ReloadServerData();
        }
        else Snackbar.Add(resp?.Error ?? "Erro ao alterar forma de pagamento.", Severity.Error);
        _saving = false;
    }

    private async Task SaveDiscountAsync()
    {
        if (_orderDetail == null) return;
        _saving = true;
        var resp = await OrderService.UpdateDiscountAsync(_orderDetail.Id, _editDiscount);
        if (resp?.Success == true)
        {
            Snackbar.Add("Desconto aplicado!", Severity.Success);
            var updated = await OrderService.GetByIdAsync(_orderDetail.Id);
            if (updated?.Success == true)
                _orderDetail = updated.Data;
            await _table!.ReloadServerData();
        }
        else Snackbar.Add(resp?.Error ?? "Erro ao aplicar desconto.", Severity.Error);
        _saving = false;
    }

    private async Task SaveDeliveryAsync()
    {
        if (_orderDetail == null) return;
        _saving = true;
        var resp = await OrderService.UpdateDeliveryStatusAsync(_orderDetail.Id, _editDelivery);
        if (resp?.Success == true)
        {
            Snackbar.Add("Status de entrega atualizado!", Severity.Success);
            _orderDetail = _orderDetail with { DeliveryStatus = _editDelivery };
            await _table!.ReloadServerData();
        }
        else Snackbar.Add(resp?.Error ?? "Erro ao atualizar.", Severity.Error);
        _saving = false;
    }

    private async Task SaveFinancialAsync()
    {
        if (_orderDetail == null) return;
        _saving = true;
        var resp = await OrderService.UpdateFinancialStatusAsync(_orderDetail.Id, _editFinancial);
        if (resp?.Success == true)
        {
            Snackbar.Add("Status financeiro atualizado!", Severity.Success);
            _orderDetail = _orderDetail with { FinancialStatus = _editFinancial };
            await _table!.ReloadServerData();
        }
        else Snackbar.Add(resp?.Error ?? "Erro ao atualizar.", Severity.Error);
        _saving = false;
    }

    private async Task UnlockAsync()
    {
        if (_orderDetail == null) return;
        _saving = true;
        var resp = await OrderService.UnlockAsync(_orderDetail.Id);
        if (resp?.Success == true)
        {
            Snackbar.Add("Pedido desbloqueado!", Severity.Success);
            _orderDetail = _orderDetail with { IsLocked = false };
        }
        else Snackbar.Add(resp?.Error ?? "Erro ao desbloquear.", Severity.Error);
        _saving = false;
    }

    private async Task PrintReceiptAsync()
    {
        if (_orderDetail == null) return;

        var c = new System.Globalization.CultureInfo("pt-BR");
        string H(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");

        var customerName    = H(_customerDetail?.LegalName    ?? _orderDetail.CustomerName);
        var customerTaxId   = H(_customerDetail?.TaxId        ?? "");
        var customerAddress = H(_customerDetail?.Address      ?? "");
        var customerPhone   = H(_customerDetail?.Phone        ?? "");
        var customerLines   =
            $"<p><b>Cliente:</b> {customerName}</p>" +
            (customerTaxId.Length   > 0 ? $"<p><b>CPF/CNPJ:</b> {customerTaxId}</p>"   : "") +
            (customerAddress.Length > 0 ? $"<p><b>Endereço:</b> {customerAddress}</p>" : "") +
            (customerPhone.Length   > 0 ? $"<p><b>Telefone:</b> {customerPhone}</p>"   : "");

        var paymentInfo = H(_orderDetail.PaymentMethodName);
        var surchargeRate = 1 + _orderDetail.SurchargePercentage / 100m;

        var sb = new System.Text.StringBuilder();
        int num = 1;
        foreach (var item in _orderDetail.Items)
        {
            var code       = item.ProductCode?.Trim().Length > 0 ? $"[{H(item.ProductCode)}]&nbsp;" : "";
            var name       = H(item.ProductName);
            var unitFinal  = Math.Round(item.UnitPrice  * surchargeRate, 2);
            var totalFinal = Math.Round(item.TotalPrice * surchargeRate, 2);

            sb.Append(
                "<div style='overflow:hidden;white-space:nowrap;text-overflow:ellipsis;" +
                           "padding-top:5px;font-weight:normal'>" +
                $"<b>#{num}</b>&nbsp;{code}{name}" +
                "</div>");

            string detail = item.Quantity == 1
                ? $"<b>R$&nbsp;{unitFinal.ToString("N2", c)}</b>"
                : $"{item.Quantity}&nbsp;un&nbsp;&times;&nbsp;R$&nbsp;{unitFinal.ToString("N2", c)}" +
                  $"&nbsp;=&nbsp;<b>R$&nbsp;{totalFinal.ToString("N2", c)}</b>";

            sb.Append(
                "<div style='text-align:right;font-size:11px;color:#444;padding-bottom:3px'>" +
                detail +
                "</div>");
            num++;
        }

        var subtotalRec   = Math.Round(_orderDetail.AmountTotal * surchargeRate, 2);
        var discount      = _orderDetail.DiscountAmount;
        var totalFinalRec = Math.Max(0m, subtotalRec - discount);

        var html =
            "<!DOCTYPE html><html><head><meta charset='utf-8'/>" +
            $"<title>Pedido #{_orderDetail.OrderNumber}</title>" +
            "<style>" +
            "body{font-family:'Courier New',monospace;font-size:12px;width:320px;margin:0 auto;padding:12px}" +
            "h2{text-align:center;margin:4px 0;font-size:15px;letter-spacing:1px}" +
            ".sub{text-align:center;margin:2px 0;font-size:11px}" +
            "p{margin:2px 0}" +
            ".totais{width:100%;border-collapse:collapse}" +
            ".totais td{padding:1px 0;vertical-align:top}" +
            ".totais td:last-child{text-align:right;white-space:nowrap}" +
            "hr{border:0;border-top:1px dashed #000;margin:6px 0}" +
            ".tot{font-weight:bold;font-size:13px}" +
            ".rodape{text-align:center;font-size:10px;margin-top:10px}" +
            "</style></head><body>" +
            "<h2>ScaleAtacado</h2>" +
            "<p class='sub'>PEDIDO DE COMPRA</p>" +
            "<hr/>" +
            $"<p><b>Pedido:</b>&nbsp;#{_orderDetail.OrderNumber}</p>" +
            $"<p><b>Data:</b>&nbsp;{_orderDetail.OrderDate.ToString("dd/MM/yyyy HH:mm", c)}</p>" +
            "<hr/>" +
            customerLines +
            "<hr/>" +
            $"<p><b>Pagamento:</b>&nbsp;{paymentInfo}</p>" +
            "<hr/>" +
            "<p style='font-size:10px;margin-bottom:2px'>ITENS</p>" +
            sb.ToString() +
            "<hr/>" +
            "<table class='totais'><tbody>" +
            $"<tr><td>Subtotal</td><td>R$&nbsp;{subtotalRec.ToString("N2", c)}</td></tr>" +
            $"<tr><td style='color:#777'>Desconto</td><td style='color:#777'>R$&nbsp;{discount.ToString("N2", c)}</td></tr>" +
            $"<tr><td class='tot'>TOTAL</td><td class='tot'>R$&nbsp;{totalFinalRec.ToString("N2", c)}</td></tr>" +
            "</tbody></table>" +
            "<hr/>" +
            "<p class='rodape'>Obrigado pela preferência!</p>" +
            "</body></html>";

        await JS.InvokeVoidAsync("printRecibo", html);
    }

    private string GetRowClass(OrderListItemDto item, int idx) =>
        item.IsLocked ? "mud-theme-warning" : "";

    private static Color GetDeliveryColor(DeliveryStatus s) => s switch
    {
        DeliveryStatus.Delivered      => Color.Success,
        DeliveryStatus.OutForDelivery => Color.Info,
        DeliveryStatus.Picking        => Color.Warning,
        DeliveryStatus.Cancelled      => Color.Error,
        _ => Color.Default
    };

    private static string GetDeliveryLabel(DeliveryStatus s) => s switch
    {
        DeliveryStatus.AwaitingPicking => "Aguardando",
        DeliveryStatus.Picking         => "Em Separação",
        DeliveryStatus.OutForDelivery  => "Em Entrega",
        DeliveryStatus.Delivered       => "Entregue",
        DeliveryStatus.Cancelled       => "Cancelado",
        _ => s.ToString()
    };

    private static Color GetFinancialColor(FinancialStatus s) => s switch
    {
        FinancialStatus.Paid          => Color.Success,
        FinancialStatus.PartiallyPaid => Color.Warning,
        FinancialStatus.Cancelled     => Color.Error,
        _ => Color.Default
    };

    private static string GetFinancialLabel(FinancialStatus s) => s switch
    {
        FinancialStatus.Open          => "Em Aberto",
        FinancialStatus.Paid          => "Pago",
        FinancialStatus.PartiallyPaid => "Parcial",
        FinancialStatus.Cancelled     => "Cancelado",
        _ => s.ToString()
    };
}
