@page "/pedidos"
@attribute [Authorize]
@inject OrderService OrderService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject CustomerService CustomerService
@inject PaymentMethodService PaymentMethodService
@inject CompanyService CompanyService
@inject ProductService ProductService

<PageTitle>Pedidos — ScaleAtacado</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Pedidos</MudText>
</div>

<!-- Filtros -->
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="3">
            <MudDatePicker Label="Data inicial" @bind-Date="_filterFrom"
                Variant="Variant.Outlined" DateFormat="dd/MM/yyyy"
                Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudDatePicker Label="Data final" @bind-Date="_filterTo"
                Variant="Variant.Outlined" DateFormat="dd/MM/yyyy"
                Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="DeliveryStatus?" Label="Status Entrega" @bind-Value="_filterDelivery"
                Variant="Variant.Outlined" Dense="true" Clearable="true">
                <MudSelectItem T="DeliveryStatus?" Value="null">Todos</MudSelectItem>
                <MudSelectItem T="DeliveryStatus?" Value="DeliveryStatus.AwaitingPicking">Aguardando Separação</MudSelectItem>
                <MudSelectItem T="DeliveryStatus?" Value="DeliveryStatus.Picking">Em Separação</MudSelectItem>
                <MudSelectItem T="DeliveryStatus?" Value="DeliveryStatus.OutForDelivery">Saiu p/ Entrega</MudSelectItem>
                <MudSelectItem T="DeliveryStatus?" Value="DeliveryStatus.Delivered">Entregue</MudSelectItem>
                <MudSelectItem T="DeliveryStatus?" Value="DeliveryStatus.Cancelled">Cancelado</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="FinancialStatus?" Label="Status Financeiro" @bind-Value="_filterFinancial"
                Variant="Variant.Outlined" Dense="true" Clearable="true">
                <MudSelectItem T="FinancialStatus?" Value="null">Todos</MudSelectItem>
                <MudSelectItem T="FinancialStatus?" Value="FinancialStatus.Open">Em Aberto</MudSelectItem>
                <MudSelectItem T="FinancialStatus?" Value="FinancialStatus.Paid">Pago</MudSelectItem>
                <MudSelectItem T="FinancialStatus?" Value="FinancialStatus.PartiallyPaid">Parcialmente Pago</MudSelectItem>
                <MudSelectItem T="FinancialStatus?" Value="FinancialStatus.Cancelled">Cancelado</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" Class="d-flex justify-end gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                StartIcon="@Icons.Material.Filled.FilterAltOff"
                OnClick="ClearFiltersAsync">
                Limpar
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Search"
                OnClick="ReloadAsync">
                Filtrar
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable ServerData="ServerData" @ref="_table" Dense="true" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="OrderListItemDto" SortLabel="numero">Nº</MudTableSortLabel></MudTh>
        <MudTh>Data</MudTh>
        <MudTh>Cliente</MudTh>
        <MudTh>Pagamento</MudTh>
        <MudTh Style="text-align:right">Total</MudTh>
        <MudTh Style="text-align:center">Entrega</MudTh>
        <MudTh Style="text-align:center">Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nº"><b>#@context.OrderNumber</b></MudTd>
        <MudTd DataLabel="Data">@context.OrderDate.ToString("dd/MM/yy HH:mm")</MudTd>
        <MudTd DataLabel="Cliente">@context.CustomerName</MudTd>
        <MudTd DataLabel="Pagamento">@context.PaymentMethodName</MudTd>
        <MudTd DataLabel="Total" Style="text-align:right">R$ @context.AmountWithSurchargeTotal.ToString("N2")</MudTd>
        <MudTd DataLabel="Entrega" Style="text-align:center">
            <MudChip T="string" Size="Size.Small" Color="@GetDeliveryColor(context.DeliveryStatus)">
                @GetDeliveryLabel(context.DeliveryStatus)
            </MudChip>
        </MudTd>
        <MudTd Style="text-align:center">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                OnClick="@(() => ViewDetailsAsync(context.Id))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>Nenhum pedido encontrado.</NoRecordsContent>
    <LoadingContent>Carregando...</LoadingContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
    </PagerContent>
</MudTable>

<!-- Dialog: Detalhes do Pedido -->
<MudDialog @bind-Visible="_dialogDetails" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        @if (_orderDetail != null)
        {
            <span>Pedido #@_orderDetail.OrderNumber — @_orderDetail.CustomerName</span>
        }
    </TitleContent>
    <DialogContent>
        @if (_orderDetail == null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            var _surchargeRate = 1 + _orderDetail.SurchargePercentage / 100m;

            <MudGrid Class="mb-3">
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Data</MudText>
                    <MudText Typo="Typo.body2">@_orderDetail.OrderDate.ToString("dd/MM/yyyy HH:mm")</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Pagamento</MudText>
                    @if (_orderDetail.PaymentMethods.Count > 1)
                    {
                        @foreach (var pm in _orderDetail.PaymentMethods)
                        {
                            <MudText Typo="Typo.body2">@pm.Name: R$ @pm.Amount.ToString("N2")</MudText>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@string.Join(" + ", _orderDetail.PaymentMethods.Select(p => p.Name))</MudText>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(_orderDetail.IsInstallment ? "A Prazo" : "À Vista")</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Subtotal</MudText>
                    <MudText Typo="Typo.body2">R$ @_orderDetail.AmountTotal.ToString("N2")</MudText>
                </MudItem>
                @if (_orderDetail.SurchargePercentage > 0)
                {
                    var surchargeAmt = _orderDetail.AmountTotal * _orderDetail.SurchargePercentage / 100m;
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Acréscimo (@_orderDetail.SurchargePercentage.ToString("N1")%)</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Warning">+ R$ @surchargeAmt.ToString("N2")</MudText>
                    </MudItem>
                }
                @if (_orderDetail.DiscountAmount > 0)
                {
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Desconto</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Success">− R$ @_orderDetail.DiscountAmount.ToString("N2")</MudText>
                    </MudItem>
                }
                @if (_orderDetail.FixedFeeAmount > 0)
                {
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Taxa Operacional</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Warning">+ R$ @_orderDetail.FixedFeeAmount.ToString("N2")</MudText>
                    </MudItem>
                }
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Final</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Primary"><b>R$ @_orderDetail.AmountWithSurchargeTotal.ToString("N2")</b></MudText>
                </MudItem>
            </MudGrid>

            <MudTable Items="_orderDetail.Items" Dense="true" Striped="true" Class="mb-2">
                <HeaderContent>
                    <MudTh>Produto</MudTh>
                    <MudTh Style="text-align:right">Preço Unit.</MudTh>
                    <MudTh Style="text-align:center">Qtd</MudTh>
                    <MudTh Style="text-align:right">Total</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ProductName</MudTd>
                    <MudTd Style="text-align:right">R$ @((context.UnitPrice * _surchargeRate).ToString("N2"))</MudTd>
                    <MudTd Style="text-align:center">@context.Quantity</MudTd>
                    <MudTd Style="text-align:right">R$ @((context.TotalPrice * _surchargeRate).ToString("N2"))</MudTd>
                </RowTemplate>
            </MudTable>
            @if (_orderDetail.SurchargePercentage > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3" Style="display:block">
                    * Preços exibidos com acréscimo de @_orderDetail.SurchargePercentage.ToString("N1")% (@string.Join(" + ", _orderDetail.PaymentMethods.Select(p => p.Name))) já incluído.
                </MudText>
            }

            <!-- Editar Itens + Desconto — apenas Admin -->
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <!-- Editar Itens -->
                    <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-divider)">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2" Style="display:block;font-weight:600;letter-spacing:0.06em;text-transform:uppercase">
                            Editar Itens
                        </MudText>

                        @foreach (var item in _editItems)
                        {
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudText Typo="Typo.body2" Style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                    @item.ProductName
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap">
                                    R$ @item.UnitPrice.ToString("N2")
                                </MudText>
                                <MudNumericField T="int" Value="item.Quantity" Min="1" Max="9999"
                                    ValueChanged="@(v => { item.Quantity = v; StateHasChanged(); })"
                                    Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:80px" />
                                <MudText Typo="Typo.body2" Style="min-width:80px;text-align:right;white-space:nowrap">
                                    R$ @((item.UnitPrice * item.Quantity).ToString("N2"))
                                </MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                    Size="Size.Small"
                                    OnClick="@(() => { _editItems.Remove(item); StateHasChanged(); })" />
                            </div>
                        }

                        <MudGrid Class="mt-2">
                            <MudItem xs="12" sm="7">
                                <MudAutocomplete T="ProductResponseDto"
                                    Label="Adicionar produto"
                                    @bind-Value="_addProduct"
                                    SearchFunc="SearchProductsForEditAsync"
                                    ToStringFunc="@(p => p != null ? $"{p.Name} — R$ {p.BaseSalePrice:N2}" : string.Empty)"
                                    Variant="Variant.Outlined" Dense="true" FullWidth="true" Clearable="true" />
                            </MudItem>
                            <MudItem xs="6" sm="2">
                                <MudNumericField @bind-Value="_addQty" Label="Qtd"
                                    Variant="Variant.Outlined" Min="1" Max="9999" />
                            </MudItem>
                            <MudItem xs="6" sm="3" Class="d-flex align-end">
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                                    OnClick="AddEditItem" Disabled="@(_addProduct == null)" Style="height:56px">
                                    + Adicionar
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-3"
                            OnClick="SaveItemsAsync" Disabled="@(_saving || _editItems.Count == 0)">
                            Salvar Itens
                        </MudButton>
                    </MudPaper>

                    <!-- Desconto -->
                    <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-divider)">
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_editDiscount" Label="Desconto (R$)"
                                    Variant="Variant.Outlined" Min="0m" Format="N2"
                                    HelperText="Desconto em reais aplicado ao total do pedido" />
                            </MudItem>
                            <MudItem xs="12" sm="6" Class="d-flex align-end">
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true"
                                    OnClick="SaveDiscountAsync" Disabled="_saving">
                                    Aplicar Desconto
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </Authorized>
            </AuthorizeView>

            <!-- Observações -->
            <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-divider)">
                <MudTextField @bind-Value="_editNotes"
                    Label="Observações"
                    Placeholder="Instruções de entrega, condições especiais, etc."
                    Variant="Variant.Outlined"
                    Lines="3"
                    MaxLength="500"
                    FullWidth="true"
                    Class="mb-2" />
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                    OnClick="SaveNotesAsync" Disabled="_saving">
                    Salvar Observações
                </MudButton>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="DeliveryStatus" Label="Status de Entrega"
                        @bind-Value="_editDelivery" Variant="Variant.Outlined" Dense="true">
                        <MudSelectItem T="DeliveryStatus" Value="DeliveryStatus.AwaitingPicking">Aguardando Separação</MudSelectItem>
                        <MudSelectItem T="DeliveryStatus" Value="DeliveryStatus.Picking">Em Separação</MudSelectItem>
                        <MudSelectItem T="DeliveryStatus" Value="DeliveryStatus.OutForDelivery">Saiu para Entrega</MudSelectItem>
                        <MudSelectItem T="DeliveryStatus" Value="DeliveryStatus.Delivered">Entregue</MudSelectItem>
                        <MudSelectItem T="DeliveryStatus" Value="DeliveryStatus.Cancelled">Cancelado</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                        OnClick="SaveDeliveryAsync" Disabled="_saving">
                        Salvar Entrega
                    </MudButton>
                </MudItem>
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <!-- Alterar Forma de Pagamento -->
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2" Style="display:block">
                                ADMINISTRAÇÃO
                            </MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudButtonGroup Variant="Variant.Outlined" FullWidth="true" Class="mb-2">
                                <MudButton Color="@(!_editIsInstallment ? Color.Primary : Color.Default)"
                                    Variant="@(!_editIsInstallment ? Variant.Filled : Variant.Outlined)"
                                    OnClick="@(() => { _editIsInstallment = false; _editPaymentMethodIds = Array.Empty<Guid>(); _editPaymentMethodId = Guid.Empty; })"
                                    Disabled="_saving" Style="flex:1">
                                    À Vista
                                </MudButton>
                                <MudButton Color="@(_editIsInstallment ? Color.Primary : Color.Default)"
                                    Variant="@(_editIsInstallment ? Variant.Filled : Variant.Outlined)"
                                    OnClick="@(() => { _editIsInstallment = true; _editPaymentMethodIds = Array.Empty<Guid>(); _editPaymentMethodId = Guid.Empty; })"
                                    Disabled="_saving" Style="flex:1">
                                    A Prazo
                                </MudButton>
                            </MudButtonGroup>
                        </MudItem>
                        @if (!_editIsInstallment)
                        {
                            <MudItem xs="12" sm="8">
                                <MudSelect T="Guid" Label="Formas de Pagamento (À Vista)"
                                    MultiSelection="true"
                                    SelectedValues="_editPaymentMethodIds"
                                    SelectedValuesChanged="@((IReadOnlyCollection<Guid> vals) => OnEditPMsChanged(vals))"
                                    Variant="Variant.Outlined" Dense="true"
                                    ToStringFunc="@(id => _paymentMethods.FirstOrDefault(p => p.Id == id)?.Name ?? string.Empty)">
                                    @foreach (var pm in _paymentMethods.Where(p => !p.IsInstallment))
                                    {
                                        <MudSelectItem T="Guid" Value="pm.Id">
                                            @pm.Name
                                            @if (pm.SurchargePercentage > 0)
                                            {
                                                <span style="color:var(--mud-palette-warning)"> (+@pm.SurchargePercentage.ToString("N1")%)</span>
                                            }
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            @if (_editPaymentMethodIds.Count > 1)
                            {
                                <MudItem xs="12">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1" Style="display:block">
                                        Valores por forma de pagamento:
                                    </MudText>
                                    @foreach (var pmId in _editPaymentMethodIds)
                                    {
                                        var pmLabel = _paymentMethods.FirstOrDefault(p => p.Id == pmId)?.Name ?? string.Empty;
                                        <div class="d-flex align-center gap-2 mb-2">
                                            <MudText Typo="Typo.body2" Style="min-width:90px">@pmLabel:</MudText>
                                            <MudNumericField T="decimal"
                                                Value="_editPmAmounts.GetValueOrDefault(pmId)"
                                                ValueChanged="@(v => { _editPmAmounts[pmId] = v; StateHasChanged(); })"
                                                Min="0m" Format="N2"
                                                Variant="Variant.Outlined" Margin="Margin.Dense"
                                                Style="flex:1" />
                                        </div>
                                    }
                                    <div class="d-flex justify-space-between mt-1">
                                        <MudText Typo="Typo.caption">Restante:</MudText>
                                        <MudText Typo="Typo.caption" Color="@(Math.Abs(_orderDetail!.AmountWithSurchargeTotal - _editPmAmounts.Values.Sum()) < 0.01m ? Color.Success : Color.Error)">
                                            R$ @((_orderDetail!.AmountWithSurchargeTotal - _editPmAmounts.Values.Sum()).ToString("N2"))
                                        </MudText>
                                    </div>
                                </MudItem>
                            }
                        }
                        else
                        {
                            <MudItem xs="12" sm="8">
                                <MudSelect T="Guid" Label="Forma de Pagamento (A Prazo)"
                                    @bind-Value="_editPaymentMethodId"
                                    Variant="Variant.Outlined" Dense="true"
                                    ToStringFunc="@(id => _paymentMethods.FirstOrDefault(p => p.Id == id)?.Name ?? string.Empty)">
                                    @foreach (var pm in _paymentMethods.Where(p => p.IsInstallment))
                                    {
                                        <MudSelectItem T="Guid" Value="pm.Id">
                                            @pm.Name
                                            @if (pm.SurchargePercentage > 0)
                                            {
                                                <span style="color:var(--mud-palette-warning)"> (+@pm.SurchargePercentage.ToString("N1")%)</span>
                                            }
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                        <MudItem xs="12" sm="4" Class="d-flex align-end">
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                OnClick="SavePaymentMethodAsync" Disabled="_saving"
                                StartIcon="@Icons.Material.Filled.SwapHoriz">
                                Alterar Pagamento
                            </MudButton>
                        </MudItem>

                        <!-- Status Financeiro -->
                        <MudItem xs="12" sm="6">
                            <MudSelect T="FinancialStatus" Label="Status Financeiro"
                                @bind-Value="_editFinancial" Variant="Variant.Outlined" Dense="true">
                                <MudSelectItem T="FinancialStatus" Value="FinancialStatus.Open">Em Aberto</MudSelectItem>
                                <MudSelectItem T="FinancialStatus" Value="FinancialStatus.Paid">Pago</MudSelectItem>
                                <MudSelectItem T="FinancialStatus" Value="FinancialStatus.PartiallyPaid">Parcialmente Pago</MudSelectItem>
                                <MudSelectItem T="FinancialStatus" Value="FinancialStatus.Cancelled">Cancelado</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="d-flex align-end">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                OnClick="SaveFinancialAsync" Disabled="_saving">
                                Salvar Financeiro
                            </MudButton>
                        </MudItem>
                        @if (_orderDetail.IsLocked)
                        {
                            <MudItem xs="12">
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true"
                                    StartIcon="@Icons.Material.Filled.LockOpen"
                                    OnClick="UnlockAsync" Disabled="_saving">
                                    Desbloquear Pedido
                                </MudButton>
                            </MudItem>
                        }
                    </Authorized>
                </AuthorizeView>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        @if (_orderDetail != null)
        {
            <MudButton StartIcon="@Icons.Material.Filled.Print" Color="Color.Secondary"
                OnClick="OpenPrintPreview">
                Imprimir Recibo
            </MudButton>
        }
        <MudButton OnClick="@(() => _dialogDetails = false)">Fechar</MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog: Prévia de Impressão -->
<MudDialog @bind-Visible="_printPreviewOpen"
    Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" />
            <span>Prévia do Recibo — Pedido #@(_orderDetail?.OrderNumber)</span>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_orderDetail != null && _orderDetail.Version > (_orderDetail.LastPrintedVersion ?? 0))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                @if (_orderDetail.LastPrintedVersion == null)
                {
                    <span>Este pedido ainda não foi impresso.</span>
                }
                else
                {
                    <span>Pedido alterado após a última impressão (v@(_orderDetail.LastPrintedVersion) → v@(_orderDetail.Version)). Este recibo reflete a versão atual.</span>
                }
            </MudAlert>
        }
        <iframe srcdoc="@_printPreviewHtml"
            style="width:100%;height:520px;border:none;display:block;background:#fff" />
        <div class="d-flex align-center gap-3 mt-3">
            <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Default" />
            <MudText Typo="Typo.body2">Número de cópias:</MudText>
            <MudNumericField T="int" @bind-Value="_copies"
                Min="1" Max="10" Step="1"
                Variant="Variant.Outlined" Margin="Margin.Dense"
                Style="width:90px" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _printPreviewOpen = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.Print"
            OnClick="ConfirmPrintAsync" Disabled="_saving">
            Confirmar Impressão
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudTable<OrderListItemDto>? _table;
    private DeliveryStatus? _filterDelivery;
    private FinancialStatus? _filterFinancial;
    private DateTime? _filterFrom;
    private DateTime? _filterTo;
    private bool _dialogDetails;
    private bool _saving;
    private OrderResponseDto? _orderDetail;
    private CustomerResponseDto? _customerDetail;
    private DeliveryStatus _editDelivery;
    private FinancialStatus _editFinancial;
    private decimal _editDiscount;
    private bool _editIsInstallment;
    private IReadOnlyCollection<Guid> _editPaymentMethodIds = Array.Empty<Guid>();
    private Guid _editPaymentMethodId;
    private Dictionary<Guid, decimal> _editPmAmounts = new();
    private List<PaymentMethodResponseDto> _paymentMethods = new();
    private bool _printPreviewOpen;
    private string _printPreviewHtml = "";
    private int _copies = 1;
    private CompanyResponseDto? _company;
    private List<ProductResponseDto> _products = new();
    private List<EditItemVm> _editItems = new();
    private ProductResponseDto? _addProduct;
    private int _addQty = 1;
    private string? _editNotes;

    protected override async Task OnInitializedAsync()
    {
        var pmResp   = await PaymentMethodService.GetAllAsync(onlyActive: true);
        _paymentMethods = pmResp?.Data?.ToList() ?? new();

        var compResp = await CompanyService.GetAsync();
        _company = compResp?.Data;

        var prodResp = await ProductService.GetAllActiveAsync();
        _products = prodResp?.Data?.ToList() ?? new();
    }

    private async Task<TableData<OrderListItemDto>> ServerData(TableState state, CancellationToken ct)
    {
        var resp = await OrderService.GetAllAsync(state.Page + 1, state.PageSize,
            _filterDelivery, _filterFinancial, _filterFrom, _filterTo);
        if (resp?.Success == true && resp.Data != null)
            return new TableData<OrderListItemDto> { Items = resp.Data.Items, TotalItems = resp.Data.TotalCount };
        return new TableData<OrderListItemDto> { Items = [], TotalItems = 0 };
