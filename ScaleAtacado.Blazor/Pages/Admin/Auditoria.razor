@page "/admin/auditoria"
@attribute [Authorize(Roles = "Admin")]
@inject AuditLogService AuditLogService
@inject ISnackbar Snackbar

<PageTitle>Auditoria — ScaleAtacado</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Log de Auditoria</MudText>
</div>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="3">
            <MudDatePicker @bind-Date="_dateFrom" Label="De" Variant="Variant.Outlined"
                DateFormat="dd/MM/yyyy" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudDatePicker @bind-Date="_dateTo" Label="Até" Variant="Variant.Outlined"
                DateFormat="dd/MM/yyyy" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="string?" Label="Entidade" @bind-Value="_filterEntity"
                Variant="Variant.Outlined" Dense="true" Clearable="true">
                <MudSelectItem T="string?" Value="null">Todas</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Pedido")">Pedido</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Cliente")">Cliente</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Produto")">Produto</MudSelectItem>
                <MudSelectItem T="string?" Value="@("FormaPagamento")">Forma de Pagamento</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Usuario")">Usuário</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                OnClick="LoadAsync" StartIcon="@Icons.Material.Filled.Search"
                Disabled="_loading">
                Filtrar
            </MudButton>
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="_searchText" Label="Buscar em operação, descrição ou usuário"
                Variant="Variant.Outlined" Clearable="true" Immediate="true"
                Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ManageSearch" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="_records" Filter="FilterRecord" Dense="true" Hover="true" Striped="true" Loading="_loading"
    FixedHeader="true" Height="600px">
    <HeaderContent>
        <MudTh>Data/Hora</MudTh>
        <MudTh>Usuário</MudTh>
        <MudTh>Operação</MudTh>
        <MudTh>Descrição</MudTh>
        <MudTh>Entidade</MudTh>
        <MudTh Style="text-align:center">Detalhes</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Data">@context.Timestamp.ToLocalTime().ToString("dd/MM/yy HH:mm")</MudTd>
        <MudTd DataLabel="Usuário">
            <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(context.UserName) ? "—" : context.UserName)</MudText>
        </MudTd>
        <MudTd DataLabel="Operação">
            <MudChip T="string" Size="Size.Small" Color="@GetOperationColor(context.Operation)">
                @context.Operation
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Descrição">
            <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(context.Description) ? "—" : context.Description)</MudText>
        </MudTd>
        <MudTd DataLabel="Entidade">@context.EntityName</MudTd>
        <MudTd Style="text-align:center">
            @if (!string.IsNullOrEmpty(context.PreviousValue) || !string.IsNullOrEmpty(context.NewValue))
            {
                <MudIconButton Icon="@Icons.Material.Filled.CompareArrows" Size="Size.Small"
                    Color="Color.Info" OnClick="@(() => ViewDetails(context))" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (!_searched)
        {
            <MudText>Selecione um período e clique em Filtrar.</MudText>
        }
        else
        {
            <MudText>Nenhum registro encontrado.</MudText>
        }
    </NoRecordsContent>
    <LoadingContent>Carregando...</LoadingContent>
</MudTable>

<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
    @_records.Count registro(s) carregado(s)
    @if (!string.IsNullOrWhiteSpace(_searchText) || !string.IsNullOrEmpty(_filterEntity))
    {
        <span> — filtro ativo</span>
    }
</MudText>

<!-- Dialog: Antes / Depois -->
<MudDialog @bind-Visible="_dialogDetails" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>Detalhes da Alteração</TitleContent>
    <DialogContent>
        @if (_selected != null)
        {
            <MudGrid Class="mb-3">
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Data</MudText>
                    <MudText>@_selected.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Usuário</MudText>
                    <MudText>@(string.IsNullOrEmpty(_selected.UserName) ? "—" : _selected.UserName)</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Operação</MudText>
                    <MudText>@_selected.Operation — @_selected.EntityName</MudText>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_selected.PreviousValue))
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">Valor Anterior:</MudText>
                <MudPaper Class="pa-2 mb-3" Style="background:#f5f5f5; overflow:auto; max-height:200px">
                    <pre style="font-size:12px; white-space:pre-wrap">@_selected.PreviousValue</pre>
                </MudPaper>
            }

            @if (!string.IsNullOrEmpty(_selected.NewValue))
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">Valor Novo:</MudText>
                <MudPaper Class="pa-2" Style="background:#f5f5f5; overflow:auto; max-height:200px">
                    <pre style="font-size:12px; white-space:pre-wrap">@_selected.NewValue</pre>
                </MudPaper>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogDetails = false)">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<AuditLogResponseDto> _records = new();
    private bool _loading;
    private bool _searched;
    private bool _dialogDetails;
    private AuditLogResponseDto? _selected;
    private DateTime? _dateFrom = DateTime.Today.AddDays(-7);
    private DateTime? _dateTo = DateTime.Today;
    private string _searchText = "";
    private string? _filterEntity;

    private bool FilterRecord(AuditLogResponseDto r)
    {
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var s = _searchText.Trim().ToLowerInvariant();
            var matchOp   = r.Operation.ToLowerInvariant().Contains(s);
            var matchDesc = r.Description?.ToLowerInvariant().Contains(s) == true;
            var matchUser = r.UserName?.ToLowerInvariant().Contains(s) == true;
            if (!matchOp && !matchDesc && !matchUser) return false;
        }
        if (!string.IsNullOrEmpty(_filterEntity) && r.EntityName != _filterEntity)
            return false;
        return true;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _searched = true;
        var resp = await AuditLogService.GetAllAsync(_dateFrom, _dateTo);
        _records = resp?.Data?.OrderByDescending(r => r.Timestamp).ToList() ?? new();
        _loading = false;
    }

    private void ViewDetails(AuditLogResponseDto r)
    {
        _selected = r;
        _dialogDetails = true;
    }

    private static Color GetOperationColor(string op) => op switch
    {
        "CriarPedido" or "CriarCliente" or "CriarFormaPagamento" or "CriarProduto" or "CriarUsuario" => Color.Success,
        "EditarCliente" or "EditarFormaPagamento" or "EditarProduto" or "EditarUsuario" => Color.Info,
        "FinalizarPedido" or "ImprimirPedido" or "DesbloquearPedido" or "Login" or "ReativarUsuario" => Color.Primary,
        "AlterarEntrega" or "AlterarFinanceiro" or "AlterarPagamento" or "AlterarPreco" or "AplicarDesconto" => Color.Warning,
        "CancelarPedido" or "DesativarCliente" or "DesativarFormaPagamento" or "InativarProduto" or "DesativarUsuario" or "Logoff" => Color.Error,
        _ => Color.Default
    };
}
