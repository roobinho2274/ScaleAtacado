@page "/clientes"
@attribute [Authorize]
@inject ClienteService ClienteService
@inject ISnackbar Snackbar

<PageTitle>Clientes — ScaleAtacado</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Clientes</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AbrirNovo">
        Novo Cliente
    </MudButton>
</div>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_busca" Label="Buscar por nome ou documento"
                Variant="Variant.Outlined"
                Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                OnKeyUp="OnKeyUp" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                OnClick="CarregarAsync" StartIcon="@Icons.Material.Filled.Search">
                Buscar
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="_clientes" Dense="true" Hover="true" Striped="true" Loading="_carregando">
    <HeaderContent>
        <MudTh>Nome / Razão Social</MudTh>
        <MudTh>Documento</MudTh>
        <MudTh>Telefone</MudTh>
        <MudTh>Endereço</MudTh>
        <MudTh Style="text-align:center">Status</MudTh>
        <MudTh Style="text-align:center">Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nome">@context.NomeRazaoSocial</MudTd>
        <MudTd DataLabel="Documento">@context.Documento</MudTd>
        <MudTd DataLabel="Telefone">@context.Telefone</MudTd>
        <MudTd DataLabel="Endereço">@context.Endereco</MudTd>
        <MudTd DataLabel="Status" Style="text-align:center">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                @(context.IsActive ? "Ativo" : "Inativo")
            </MudChip>
        </MudTd>
        <MudTd Style="text-align:center">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                OnClick="@(() => AbrirEdicao(context))" />
            @if (context.IsActive)
            {
                <MudIconButton Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small"
                    Color="Color.Error" OnClick="@(() => DesativarAsync(context))" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>Nenhum cliente encontrado.</NoRecordsContent>
</MudTable>

<!-- Dialog: Criar / Editar -->
<MudDialog @bind-Visible="_dialogAberto" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>@(_editando == null ? "Novo Cliente" : "Editar Cliente")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_form.NomeRazaoSocial" Label="Nome / Razão Social"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true" />
        <MudTextField @bind-Value="_form.Documento" Label="CPF / CNPJ"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" />
        <MudTextField @bind-Value="_form.Telefone" Label="Telefone"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" />
        <MudTextField @bind-Value="_form.Endereco" Label="Endereço"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" />
        <MudTextField @bind-Value="_form.Observacoes" Label="Observações"
            Variant="Variant.Outlined" FullWidth="true" Lines="2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogAberto = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            OnClick="SalvarAsync" Disabled="_salvando">
            @if (_salvando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<ClienteResponseDto> _clientes = new();
    private string _busca = "";
    private bool _carregando;
    private bool _dialogAberto;
    private bool _salvando;
    private ClienteResponseDto? _editando;
    private FormVm _form = new();

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        var resp = await ClienteService.SearchAsync(_busca);
        _clientes = resp?.Data?.ToList() ?? new();
        _carregando = false;
    }

    private void AbrirNovo()
    {
        _editando = null;
        _form = new FormVm();
        _dialogAberto = true;
    }

    private void AbrirEdicao(ClienteResponseDto c)
    {
        _editando = c;
        _form = new FormVm
        {
            NomeRazaoSocial = c.NomeRazaoSocial,
            Documento = c.Documento,
            Telefone = c.Telefone,
            Endereco = c.Endereco,
            Observacoes = c.Observacoes ?? ""
        };
        _dialogAberto = true;
    }

    private async Task SalvarAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.NomeRazaoSocial)) return;
        _salvando = true;

        if (_editando == null)
        {
            var dto = new CreateClienteDto(_form.NomeRazaoSocial, _form.Documento, _form.Endereco, _form.Telefone, _form.Observacoes);
            var resp = await ClienteService.CreateAsync(dto);
            if (resp?.Success == true)
            {
                Snackbar.Add("Cliente criado com sucesso!", Severity.Success);
                _dialogAberto = false;
                await CarregarAsync();
            }
            else Snackbar.Add(resp?.Error ?? "Erro ao criar.", Severity.Error);
        }
        else
        {
            var dto = new UpdateClienteDto(_form.NomeRazaoSocial, _form.Documento, _form.Endereco, _form.Telefone, _form.Observacoes, true);
            var resp = await ClienteService.UpdateAsync(_editando.Id, dto);
            if (resp?.Success == true)
            {
                Snackbar.Add("Cliente atualizado!", Severity.Success);
                _dialogAberto = false;
                await CarregarAsync();
            }
            else Snackbar.Add(resp?.Error ?? "Erro ao atualizar.", Severity.Error);
        }

        _salvando = false;
    }

    private async Task DesativarAsync(ClienteResponseDto c)
    {
        var resp = await ClienteService.DeactivateAsync(c.Id);
        if (resp?.Success == true)
        {
            Snackbar.Add("Cliente desativado.", Severity.Info);
            await CarregarAsync();
        }
        else Snackbar.Add(resp?.Error ?? "Erro.", Severity.Error);
    }

    private class FormVm
    {
        public string NomeRazaoSocial { get; set; } = "";
        public string Documento { get; set; } = "";
        public string Telefone { get; set; } = "";
        public string Endereco { get; set; } = "";
        public string? Observacoes { get; set; }
    }
}
