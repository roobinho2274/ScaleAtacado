        DeliveryStatus.OutForDelivery => Color.Info,
        DeliveryStatus.Picking        => Color.Warning,
        DeliveryStatus.Cancelled      => Color.Error,
        _ => Color.Default
    };

    private static string GetDeliveryLabel(DeliveryStatus s) => s switch
    {
        DeliveryStatus.AwaitingPicking => "Aguardando",
        DeliveryStatus.Picking         => "Em Separação",
        DeliveryStatus.OutForDelivery  => "Em Entrega",
        DeliveryStatus.Delivered       => "Entregue",
        DeliveryStatus.Cancelled       => "Cancelado",
        _ => s.ToString()
    };

    private static Color GetFinancialColor(FinancialStatus s) => s switch
    {
        FinancialStatus.Paid          => Color.Success,
        FinancialStatus.PartiallyPaid => Color.Warning,
        FinancialStatus.Cancelled     => Color.Error,
        _ => Color.Default
    };

    private static string GetFinancialLabel(FinancialStatus s) => s switch
    {
        FinancialStatus.Open          => "Em Aberto",
        FinancialStatus.Paid          => "Pago",
        FinancialStatus.PartiallyPaid => "Parcial",
        FinancialStatus.Cancelled     => "Cancelado",
        _ => s.ToString()
    };

    private void OnEditPMsChanged(IReadOnlyCollection<Guid> vals)
    {
        _editPaymentMethodIds = vals;
        var idSet = vals.ToHashSet();
        foreach (var id in _editPmAmounts.Keys.ToList())
            if (!idSet.Contains(id)) _editPmAmounts.Remove(id);
        foreach (var id in vals)
            if (!_editPmAmounts.ContainsKey(id)) _editPmAmounts[id] = 0m;
        StateHasChanged();
    }
