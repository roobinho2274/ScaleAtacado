@page "/admin/categorias"
@attribute [Authorize(Roles = "Admin")]
@inject CategoryService CategoryService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Categorias — ScaleAtacado</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Categorias</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNew">
        Nova Categoria
    </MudButton>
</div>

<MudTable Items="_categories" Dense="true" Hover="true" Striped="true" Loading="_loading">
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>Descrição</MudTh>
        <MudTh Style="text-align:center">Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nome"><b>@context.Name</b></MudTd>
        <MudTd DataLabel="Descrição">@(context.Description ?? "—")</MudTd>
        <MudTd Style="text-align:center">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                OnClick="@(() => OpenEdit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                Color="Color.Error" OnClick="@(() => DeleteAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>Nenhuma categoria cadastrada.</NoRecordsContent>
</MudTable>

<!-- Dialog -->
<MudDialog @bind-Visible="_dialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>@(_editing == null ? "Nova Categoria" : "Editar Categoria")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_form.Name" Label="Nome" Variant="Variant.Outlined"
            Placeholder="ex: Bebidas, Laticínios, Hortifruti"
            FullWidth="true" Class="mb-3" Required="true"
            Error="@(_errorName != null)" ErrorText="@_errorName" />
        <MudTextField @bind-Value="_form.Description" Label="Descrição" Variant="Variant.Outlined"
            Placeholder="Breve descrição do que esta categoria engloba (opcional)"
            FullWidth="true" Lines="2"
            Error="@(_errorDescription != null)" ErrorText="@_errorDescription" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogOpen = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            OnClick="SaveAsync" Disabled="_saving">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<CategoryResponseDto> _categories = new();
    private bool _loading;
    private bool _dialogOpen;
    private bool _saving;
    private CategoryResponseDto? _editing;
    private FormVm _form = new();

    private string? _errorName;
    private string? _errorDescription;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var resp = await CategoryService.GetAllAsync();
        _categories = resp?.Data?.ToList() ?? new();
        _loading = false;
    }

    private void ClearErrors() => _errorName = _errorDescription = null;

    private void OpenNew()
    {
        _editing = null;
        _form = new FormVm();
        ClearErrors();
        _dialogOpen = true;
    }

    private void OpenEdit(CategoryResponseDto c)
    {
        _editing = c;
        _form = new FormVm { Name = c.Name, Description = c.Description ?? "" };
        ClearErrors();
        _dialogOpen = true;
    }

    private bool ValidateCategory()
    {
        ClearErrors();

        if (string.IsNullOrWhiteSpace(_form.Name))
            _errorName = "Nome é obrigatório.";
        else if (_form.Name.Trim().Length > 100)
            _errorName = "Nome deve ter no máximo 100 caracteres.";

        if (!string.IsNullOrEmpty(_form.Description) && _form.Description.Length > 250)
            _errorDescription = "Descrição deve ter no máximo 250 caracteres.";

        return _errorName == null && _errorDescription == null;
    }

    private async Task SaveAsync()
    {
        if (!ValidateCategory()) return;
        _saving = true;

        if (_editing == null)
        {
            var resp = await CategoryService.CreateAsync(new CreateCategoryDto(_form.Name.Trim(), _form.Description));
            if (resp?.Success == true)
            {
                Snackbar.Add("Categoria criada!", Severity.Success);
                _dialogOpen = false;
                await LoadAsync();
            }
            else Snackbar.Add(resp?.Error ?? "Erro ao criar categoria.", Severity.Error);
        }
        else
        {
            var resp = await CategoryService.UpdateAsync(_editing.Id, new UpdateCategoryDto(_form.Name.Trim(), _form.Description));
            if (resp?.Success == true)
            {
                Snackbar.Add("Categoria atualizada!", Severity.Success);
                _dialogOpen = false;
                await LoadAsync();
            }
            else Snackbar.Add(resp?.Error ?? "Erro ao atualizar categoria.", Severity.Error);
        }

        _saving = false;
    }

    private async Task DeleteAsync(CategoryResponseDto c)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "⚠️ Excluir categoria permanentemente",
            $"Você está prestes a excluir \"{c.Name}\" de forma permanente.\n\nATENÇÃO: Esta ação não pode ser desfeita. A exclusão será bloqueada se houver produtos vinculados a esta categoria.",
            yesText: "Excluir permanentemente", cancelText: "Cancelar");
        if (confirmed != true) return;

        var resp = await CategoryService.DeleteAsync(c.Id);
        if (resp?.Success == true)
        {
            Snackbar.Add("Categoria excluída.", Severity.Info);
            await LoadAsync();
        }
        else Snackbar.Add(resp?.Error ?? "Erro ao excluir.", Severity.Error);
    }

    private class FormVm
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
    }
}
