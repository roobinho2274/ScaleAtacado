    private string BuildReceiptHtml()
    {
        var o = _orderDetail!;
        var c = new System.Globalization.CultureInfo("pt-BR");
        string H(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");

        var customerName    = H(_customerDetail?.LegalName ?? o.CustomerName);
        var customerTaxId   = H(_customerDetail?.TaxId     ?? "");
        var customerAddress = H(_customerDetail?.Address   ?? "");
        var customerPhone   = H(_customerDetail?.Phone     ?? "");

        var customerLines =
            $"<p><b>Cliente:</b> {customerName}</p>" +
            (customerTaxId.Length   > 0 ? $"<p><b>CPF/CNPJ:</b> {customerTaxId}</p>"   : "") +
            (customerAddress.Length > 0 ? $"<p><b>Endereço:</b> {customerAddress}</p>" : "") +
            (customerPhone.Length   > 0 ? $"<p><b>Telefone:</b> {customerPhone}</p>"   : "");

        var surchargeRate = 1 + o.SurchargePercentage / 100m;
        var sb = new System.Text.StringBuilder();
        int num = 1;
        foreach (var item in o.Items)
        {
            var code       = item.ProductCode?.Trim().Length > 0 ? $"[{H(item.ProductCode)}]&nbsp;" : "";
            var unitFinal  = Math.Round(item.UnitPrice  * surchargeRate, 2);
            var totalFinal = Math.Round(item.TotalPrice * surchargeRate, 2);
            string detail  = item.Quantity == 1
                ? $"<b>R$&nbsp;{unitFinal.ToString("N2", c)}</b>"
                : $"{item.Quantity}&nbsp;un&nbsp;&times;&nbsp;R$&nbsp;{unitFinal.ToString("N2", c)}" +
                  $"&nbsp;=&nbsp;<b>R$&nbsp;{totalFinal.ToString("N2", c)}</b>";

            sb.Append(
                "<div style='overflow:hidden;white-space:nowrap;text-overflow:ellipsis;padding-top:5px'>" +
                $"<b>#{num}</b>&nbsp;{code}{H(item.ProductName)}</div>");
            sb.Append(
                $"<div style='text-align:right;font-size:11px;color:#444;padding-bottom:3px'>{detail}</div>");
            num++;
        }

        var subtotalRec   = Math.Round(o.AmountTotal * surchargeRate, 2);
        var totalFinalRec = Math.Max(0m, subtotalRec - o.DiscountAmount + o.FixedFeeAmount);

        var companyName    = H(_company?.Name ?? "ScaleAtacado");
        var companyCnpj    = H(_company?.CNPJ ?? "");
        var companyAddress = H(_company?.Address ?? "");

        var retificadoBanner = o.Version > 1
            ? $"<div style='background:#b71c1c;color:#fff;text-align:center;font-weight:bold;padding:4px 0;font-size:11px;letter-spacing:1px;margin-bottom:4px'>** DOCUMENTO RETIFICADO - v{o.Version} **</div>"
            : "";

        var companyHeader =
            $"<h2>{companyName}</h2>" +
            (companyCnpj.Length    > 0 ? $"<p class='sub'>CNPJ: {companyCnpj}</p>"      : "") +
            (companyAddress.Length > 0 ? $"<p class='sub'>{companyAddress}</p>"          : "") +
            "<p class='sub'>PEDIDO DE COMPRA</p>";

        return
            "<!DOCTYPE html><html><head><meta charset='utf-8'/>" +
            $"<title>Pedido #{o.OrderNumber}</title>" +
            "<style>" +
            "body{font-family:'Arial Narrow',Arial,sans-serif;font-size:12px;width:320px;margin:0 auto;padding:12px}" +
            "h2{text-align:center;margin:4px 0;font-size:15px;letter-spacing:1px}" +
            ".sub{text-align:center;margin:2px 0;font-size:11px}" +
            "p{margin:2px 0}" +
            ".totais{width:100%;border-collapse:collapse}" +
            ".totais td{padding:1px 0;vertical-align:top}" +
            ".totais td:last-child{text-align:right;white-space:nowrap}" +
            "hr{border:0;border-top:1.5px solid #000;margin:6px 0}" +
            "hr.sub{border:0;border-top:0.5px solid #000;margin:4px 0}" +
            ".tot{font-weight:bold;font-size:13px}" +
            ".rodape{text-align:center;font-size:10px;margin-top:10px}" +
            "</style></head><body>" +
            retificadoBanner +
            companyHeader +
            "<hr/>" +
            $"<p><b>Pedido:</b>&nbsp;#{o.OrderNumber}</p>" +
            $"<p><b>Data:</b>&nbsp;{o.OrderDate.ToString("dd/MM/yyyy HH:mm", c)}</p>" +
            "<hr/>" +
            customerLines +
            "<hr/>" +
            BuildPaymentHtml(o, c) +
            "<hr/>" +
            "<p style='font-size:10px;margin-bottom:2px'>ITENS</p>" +
            sb.ToString() +
            "<hr/>" +
            "<table class='totais'><tbody>" +
            $"<tr><td>Subtotal</td><td>R$&nbsp;{subtotalRec.ToString("N2", c)}</td></tr>" +
            (o.DiscountAmount > 0
                ? $"<tr><td style='color:#777'>Desconto</td><td style='color:#777'>- R$&nbsp;{o.DiscountAmount.ToString("N2", c)}</td></tr>"
                : "") +
            (o.FixedFeeAmount > 0
                ? $"<tr><td style='color:#555;font-size:10px'>Taxa Operacional</td><td style='color:#555;font-size:10px'>+ R$&nbsp;{o.FixedFeeAmount.ToString("N2", c)}</td></tr>"
                : "") +
            $"<tr><td class='tot'>TOTAL</td><td class='tot'>R$&nbsp;{totalFinalRec.ToString("N2", c)}</td></tr>" +
            "</tbody></table>" +
            (o.Notes != null
                ? "<hr/>" +
                  $"<p style='font-size:10px;margin-bottom:2px;font-weight:600'>OBSERVAÇÕES</p>" +
                  $"<p style='font-size:11px;white-space:pre-wrap'>{H(o.Notes)}</p>"
                : "") +
            "<hr/>" +
            "<p class='rodape'>Obrigado pela preferência!</p>" +
            "</body></html>";
    }

    private static string BuildPaymentHtml(OrderResponseDto o, System.Globalization.CultureInfo c)
    {
        string H(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");
        var prazo = $"<span style='font-size:10px;color:#777'>({(o.IsInstallment ? "A Prazo" : "À Vista")})</span>";

        if (o.PaymentMethods.Count <= 1)
        {
            var name = H(o.PaymentMethods.FirstOrDefault()?.Name ?? "");
            return $"<p><b>Pagamento:</b>&nbsp;{name}&nbsp;{prazo}</p>";
        }

        var sb = new System.Text.StringBuilder();
        sb.Append($"<p style='margin-bottom:2px'><b>Pagamento:</b>&nbsp;{prazo}</p>");
        sb.Append("<table style='width:100%;border-collapse:collapse;font-size:11px;margin-bottom:2px'><tbody>");
        foreach (var pm in o.PaymentMethods)
            sb.Append($"<tr><td style='padding:1px 0 1px 8px;color:#333'>{H(pm.Name)}</td>" +
                      $"<td style='text-align:right;white-space:nowrap'>R$&nbsp;{pm.Amount.ToString("N2", c)}</td></tr>");
        sb.Append("</tbody></table>");
        return sb.ToString();
    }

    private static Color GetDeliveryColor(DeliveryStatus s) => s switch
    {
