@page "/admin/formas-pagamento"
@attribute [Authorize(Roles = "Admin")]
@inject PaymentMethodService PaymentMethodService
@inject ISnackbar Snackbar

<PageTitle>Formas de Pagamento — ScaleAtacado</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Formas de Pagamento</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirNovo">
        Nova Forma
    </MudButton>
</div>

<MudTable Items="_formas" Dense="true" Hover="true" Striped="true" Loading="_carregando">
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh Style="text-align:center">Prazo (dias)</MudTh>
        <MudTh Style="text-align:right">Acréscimo (%)</MudTh>
        <MudTh Style="text-align:center">Status</MudTh>
        <MudTh Style="text-align:center">Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nome"><b>@context.Name</b></MudTd>
        <MudTd DataLabel="Prazo" Style="text-align:center">@context.DeadlineDays</MudTd>
        <MudTd DataLabel="Acréscimo" Style="text-align:right">
            @if (context.SurchargePercentage > 0)
            {
                <MudText Color="Color.Warning">@context.SurchargePercentage.ToString("N2")%</MudText>
            }
            else
            {
                <MudText Color="Color.Success">Sem acréscimo</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Status" Style="text-align:center">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                @(context.IsActive ? "Ativo" : "Inativo")
            </MudChip>
        </MudTd>
        <MudTd Style="text-align:center">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                OnClick="@(() => AbrirEdicao(context))" />
            @if (context.IsActive)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ToggleOff" Size="Size.Small"
                    Color="Color.Error" OnClick="@(() => DesativarAsync(context))" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>Nenhuma forma de pagamento cadastrada.</NoRecordsContent>
</MudTable>

<!-- Dialog -->
<MudDialog @bind-Visible="_dialogAberto" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>@(_editando == null ? "Nova Forma de Pagamento" : "Editar Forma de Pagamento")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_form.Name" Label="Nome" Variant="Variant.Outlined"
            FullWidth="true" Class="mb-3" Required="true" />
        <MudNumericField @bind-Value="_form.DeadlineDays" Label="Prazo (dias)"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Min="0" />
        <MudNumericField @bind-Value="_form.SurchargePercentage" Label="Acréscimo (%)"
            Variant="Variant.Outlined" FullWidth="true" Min="0m" Format="N2"
            HelperText="0 para sem acréscimo" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogAberto = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            OnClick="SalvarAsync" Disabled="_salvando">
            @if (_salvando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<PaymentMethodResponseDto> _formas = new();
    private bool _carregando;
    private bool _dialogAberto;
    private bool _salvando;
    private PaymentMethodResponseDto? _editando;
    private FormVm _form = new();

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _carregando = true;
        var resp = await PaymentMethodService.GetAllAsync();
        _formas = resp?.Data?.ToList() ?? new();
        _carregando = false;
    }

    private void AbrirNovo()
    {
        _editando = null;
        _form = new FormVm();
        _dialogAberto = true;
    }

    private void AbrirEdicao(PaymentMethodResponseDto f)
    {
        _editando = f;
        _form = new FormVm
        {
            Name = f.Name,
            DeadlineDays = f.DeadlineDays,
            SurchargePercentage = f.SurchargePercentage
        };
        _dialogAberto = true;
    }

    private async Task SalvarAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name)) return;
        _salvando = true;

        if (_editando == null)
        {
            var dto = new CreatePaymentMethodDto(_form.Name, _form.DeadlineDays, _form.SurchargePercentage);
            var resp = await PaymentMethodService.CreateAsync(dto);
            if (resp?.Success == true)
            {
                Snackbar.Add("Forma de pagamento criada!", Severity.Success);
                _dialogAberto = false;
                await CarregarAsync();
            }
            else Snackbar.Add(resp?.Error ?? "Erro ao criar.", Severity.Error);
        }
        else
        {
            var dto = new UpdatePaymentMethodDto(_form.Name, _form.DeadlineDays, _form.SurchargePercentage, true);
            var resp = await PaymentMethodService.UpdateAsync(_editando.Id, dto);
            if (resp?.Success == true)
            {
                Snackbar.Add("Forma de pagamento atualizada!", Severity.Success);
                _dialogAberto = false;
                await CarregarAsync();
            }
            else Snackbar.Add(resp?.Error ?? "Erro ao atualizar.", Severity.Error);
        }

        _salvando = false;
    }

    private async Task DesativarAsync(PaymentMethodResponseDto f)
    {
        var resp = await PaymentMethodService.DeactivateAsync(f.Id);
        if (resp?.Success == true)
        {
            Snackbar.Add("Forma de pagamento desativada.", Severity.Info);
            await CarregarAsync();
        }
        else Snackbar.Add(resp?.Error ?? "Erro.", Severity.Error);
    }

    private class FormVm
    {
        public string Name { get; set; } = "";
        public int DeadlineDays { get; set; }
        public decimal SurchargePercentage { get; set; }
    }
}
