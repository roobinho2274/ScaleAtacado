@page "/admin/usuarios"
@attribute [Authorize(Roles = "Admin")]
@inject UserService UserService
@inject ISnackbar Snackbar

<PageTitle>Usuários — ScaleAtacado</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Usuários</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AbrirNovo">
        Novo Usuário
    </MudButton>
</div>

<MudTable Items="_usuarios" Dense="true" Hover="true" Striped="true" Loading="_carregando">
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>E-mail</MudTh>
        <MudTh Style="text-align:center">Perfil</MudTh>
        <MudTh Style="text-align:center">Status</MudTh>
        <MudTh Style="text-align:center">Cadastro</MudTh>
        <MudTh Style="text-align:center">Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nome"><b>@context.FullName</b></MudTd>
        <MudTd DataLabel="E-mail">@context.Email</MudTd>
        <MudTd DataLabel="Perfil" Style="text-align:center">
            <MudChip T="string" Size="Size.Small"
                Color="@(context.Profile == UserProfile.Admin ? Color.Error : Color.Info)">
                @(context.Profile == UserProfile.Admin ? "Admin" : "Atendente")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Status" Style="text-align:center">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                @(context.IsActive ? "Ativo" : "Inativo")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Cadastro" Style="text-align:center">@context.CreatedAt.ToString("dd/MM/yyyy")</MudTd>
        <MudTd Style="text-align:center">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                title="Editar dados"
                OnClick="@(() => AbrirEdicao(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small"
                title="Alterar senha"
                Color="Color.Warning"
                OnClick="@(() => AbrirAlterarSenha(context))" />
            @if (context.IsActive)
            {
                <MudIconButton Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small"
                    title="Desativar usuário"
                    Color="Color.Error" OnClick="@(() => DesativarAsync(context))" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>Nenhum usuário encontrado.</NoRecordsContent>
</MudTable>

<!-- Dialog: Criar -->
<MudDialog @bind-Visible="_dialogNovo" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>Novo Usuário</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_formNovo.FullName" Label="Nome Completo"
            Placeholder="ex: Carlos Oliveira"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true"
            Error="@(_erroNomeNovo != null)" ErrorText="@_erroNomeNovo" />
        <MudTextField @bind-Value="_formNovo.Email" Label="E-mail" InputType="InputType.Email"
            Placeholder="usuario@empresa.com"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true"
            Error="@(_erroEmail != null)" ErrorText="@_erroEmail" />
        <MudTextField @bind-Value="_formNovo.Password" Label="Senha" InputType="InputType.Password"
            Placeholder="Crie uma senha segura"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-2" Required="true"
            Error="@(_erroSenha != null)" ErrorText="@_erroSenha" />
        <MudPaper Class="pa-3 mb-3" Elevation="0" Style="background:var(--mud-palette-background-grey);border-radius:4px">
            <MudText Typo="Typo.caption"><b>Regras da senha:</b></MudText>
            <MudText Typo="Typo.caption" Style="display:block">• Mínimo de 6 caracteres</MudText>
            <MudText Typo="Typo.caption" Style="display:block">• Pelo menos uma letra minúscula (a-z)</MudText>
            <MudText Typo="Typo.caption" Style="display:block">• Pelo menos um número (0-9)</MudText>
        </MudPaper>
        <MudSelect T="UserProfile" Label="Perfil" @bind-Value="_formNovo.Profile"
            Variant="Variant.Outlined" FullWidth="true">
            <MudSelectItem T="UserProfile" Value="UserProfile.Attendant">Atendente</MudSelectItem>
            <MudSelectItem T="UserProfile" Value="UserProfile.Admin">Administrador</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogNovo = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            OnClick="SalvarNovoAsync" Disabled="_salvando">
            @if (_salvando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Criar
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog: Editar -->
<MudDialog @bind-Visible="_dialogEditar" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>Editar Usuário</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_formEditar.FullName" Label="Nome Completo"
            Placeholder="ex: Carlos Oliveira"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true"
            Error="@(_erroNomeEditar != null)" ErrorText="@_erroNomeEditar" />
        <MudSelect T="UserProfile" Label="Perfil" @bind-Value="_formEditar.Profile"
            Variant="Variant.Outlined" FullWidth="true">
            <MudSelectItem T="UserProfile" Value="UserProfile.Attendant">Atendente</MudSelectItem>
            <MudSelectItem T="UserProfile" Value="UserProfile.Admin">Administrador</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogEditar = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            OnClick="SalvarEdicaoAsync" Disabled="_salvando">
            @if (_salvando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog: Alterar Senha -->
<MudDialog @bind-Visible="_dialogSenha" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        Alterar Senha — @_alterandoSenha?.FullName
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
            A senha é armazenada criptografada. Nem administradores conseguem ver a senha atual.
        </MudAlert>
        <MudTextField @bind-Value="_formSenha.NewPassword" Label="Nova Senha" InputType="InputType.Password"
            Placeholder="Crie uma senha segura"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-2" Required="true"
            Error="@(_erroNovaSenha != null)" ErrorText="@_erroNovaSenha" />
        <MudTextField @bind-Value="_formSenha.Confirm" Label="Confirmar Nova Senha" InputType="InputType.Password"
            Placeholder="Repita a senha"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true"
            Error="@(_erroConfirmar != null)" ErrorText="@_erroConfirmar" />
        <MudPaper Class="pa-3" Elevation="0" Style="background:var(--mud-palette-background-grey);border-radius:4px">
            <MudText Typo="Typo.caption"><b>Regras da senha:</b></MudText>
            <MudText Typo="Typo.caption" Style="display:block">• Mínimo de 6 caracteres</MudText>
            <MudText Typo="Typo.caption" Style="display:block">• Pelo menos uma letra minúscula (a-z)</MudText>
            <MudText Typo="Typo.caption" Style="display:block">• Pelo menos um número (0-9)</MudText>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogSenha = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning"
            OnClick="SalvarSenhaAsync" Disabled="_salvando">
            @if (_salvando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Alterar Senha
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<UserResponseDto> _usuarios = new();
    private bool _carregando;
    private bool _dialogNovo;
    private bool _dialogEditar;
    private bool _dialogSenha;
    private bool _salvando;
    private UserResponseDto? _editando;
    private UserResponseDto? _alterandoSenha;

    private NovoVm _formNovo = new();
    private EditarVm _formEditar = new();
    private SenhaVm _formSenha = new();

    private string? _erroNomeNovo;
    private string? _erroEmail;
    private string? _erroSenha;
    private string? _erroNomeEditar;
    private string? _erroNovaSenha;
    private string? _erroConfirmar;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _carregando = true;
        var resp = await UserService.GetAllAsync();
        _usuarios = resp?.Data?.ToList() ?? new();
        _carregando = false;
    }

    private void AbrirNovo()
    {
        _formNovo = new NovoVm();
        _erroNomeNovo = _erroEmail = _erroSenha = null;
        _dialogNovo = true;
    }

    private void AbrirEdicao(UserResponseDto u)
    {
        _editando = u;
        _formEditar = new EditarVm { FullName = u.FullName, Profile = u.Profile };
        _erroNomeEditar = null;
        _dialogEditar = true;
    }

    private void AbrirAlterarSenha(UserResponseDto u)
    {
        _alterandoSenha = u;
        _formSenha = new SenhaVm();
        _erroNovaSenha = _erroConfirmar = null;
        _dialogSenha = true;
    }

    private bool ValidarNovo()
    {
        _erroNomeNovo = _erroEmail = _erroSenha = null;

        if (string.IsNullOrWhiteSpace(_formNovo.FullName))
            _erroNomeNovo = "Nome completo é obrigatório.";
        else if (_formNovo.FullName.Trim().Length > 200)
            _erroNomeNovo = "Nome deve ter no máximo 200 caracteres.";

        if (string.IsNullOrWhiteSpace(_formNovo.Email))
            _erroEmail = "E-mail é obrigatório.";
        else if (!EmailValido(_formNovo.Email))
            _erroEmail = "E-mail inválido.";

        _erroSenha = ValidarSenha(_formNovo.Password);

        return _erroNomeNovo == null && _erroEmail == null && _erroSenha == null;
    }

    private bool ValidarEditar()
    {
        _erroNomeEditar = null;

        if (string.IsNullOrWhiteSpace(_formEditar.FullName))
            _erroNomeEditar = "Nome completo é obrigatório.";
        else if (_formEditar.FullName.Trim().Length > 200)
            _erroNomeEditar = "Nome deve ter no máximo 200 caracteres.";

        return _erroNomeEditar == null;
    }

    private bool ValidarAlterarSenha()
    {
        _erroNovaSenha = _erroConfirmar = null;

        _erroNovaSenha = ValidarSenha(_formSenha.NewPassword);

        if (string.IsNullOrWhiteSpace(_formSenha.Confirm))
            _erroConfirmar = "Confirmação de senha é obrigatória.";
        else if (_formSenha.NewPassword != _formSenha.Confirm)
            _erroConfirmar = "As senhas não coincidem.";

        return _erroNovaSenha == null && _erroConfirmar == null;
    }

    private static string? ValidarSenha(string senha)
    {
        if (string.IsNullOrWhiteSpace(senha))
            return "Senha é obrigatória.";
        if (senha.Length < 6)
            return "Senha deve ter no mínimo 6 caracteres.";
        if (!senha.Any(char.IsLower))
            return "Senha deve conter pelo menos uma letra minúscula (a-z).";
        if (!senha.Any(char.IsDigit))
            return "Senha deve conter pelo menos um número (0-9).";
        return null;
    }

    private static bool EmailValido(string email)
    {
        try { _ = new System.Net.Mail.MailAddress(email); return true; }
        catch { return false; }
    }

    private async Task SalvarNovoAsync()
    {
        if (!ValidarNovo()) return;
        _salvando = true;

        var dto = new CreateUserDto(_formNovo.FullName.Trim(), _formNovo.Email.Trim(), _formNovo.Password, _formNovo.Profile);
        var resp = await UserService.CreateAsync(dto);
        if (resp?.Success == true)
        {
            Snackbar.Add("Usuário criado com sucesso!", Severity.Success);
            _dialogNovo = false;
            await CarregarAsync();
        }
        else
        {
            var msg = resp?.Error ?? "Erro ao criar usuário.";
            if (msg.Contains("e-mail", StringComparison.OrdinalIgnoreCase) ||
                msg.Contains("email", StringComparison.OrdinalIgnoreCase) ||
                msg.Contains("DuplicateUserName", StringComparison.OrdinalIgnoreCase))
                _erroEmail = "Este e-mail já está em uso.";
            else
                Snackbar.Add(msg, Severity.Error);
        }

        _salvando = false;
    }

    private async Task SalvarEdicaoAsync()
    {
        if (!ValidarEditar()) return;
        _salvando = true;

        var dto = new UpdateUserDto(_formEditar.FullName.Trim(), _formEditar.Profile, true);
        var resp = await UserService.UpdateAsync(_editando!.Id, dto);
        if (resp?.Success == true)
        {
            Snackbar.Add("Usuário atualizado!", Severity.Success);
            _dialogEditar = false;
            await CarregarAsync();
        }
        else Snackbar.Add(resp?.Error ?? "Erro ao atualizar usuário.", Severity.Error);

        _salvando = false;
    }

    private async Task SalvarSenhaAsync()
    {
        if (!ValidarAlterarSenha()) return;
        _salvando = true;

        var resp = await UserService.ChangePasswordAsync(_alterandoSenha!.Id, _formSenha.NewPassword);
        if (resp?.Success == true)
        {
            Snackbar.Add($"Senha de {_alterandoSenha.FullName} alterada com sucesso!", Severity.Success);
            _dialogSenha = false;
        }
        else Snackbar.Add(resp?.Error ?? "Erro ao alterar senha.", Severity.Error);

        _salvando = false;
    }

    private async Task DesativarAsync(UserResponseDto u)
    {
        var resp = await UserService.DeactivateAsync(u.Id);
        if (resp?.Success == true)
        {
            Snackbar.Add("Usuário desativado.", Severity.Info);
            await CarregarAsync();
        }
        else Snackbar.Add(resp?.Error ?? "Erro.", Severity.Error);
    }

    private class NovoVm
    {
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public UserProfile Profile { get; set; } = UserProfile.Attendant;
    }

    private class EditarVm
    {
        public string FullName { get; set; } = "";
        public UserProfile Profile { get; set; } = UserProfile.Attendant;
    }

    private class SenhaVm
    {
        public string NewPassword { get; set; } = "";
        public string Confirm { get; set; } = "";
    }
}
