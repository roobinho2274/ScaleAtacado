    private async Task ViewDetailsAsync(Guid id)
    {
        _orderDetail = null;
        _customerDetail = null;
        _dialogDetails = true;

        var resp = await OrderService.GetByIdAsync(id);
        if (resp?.Success == true)
        {
            _orderDetail = resp.Data;
            _editDelivery      = _orderDetail!.DeliveryStatus;
            _editFinancial     = _orderDetail.FinancialStatus;
            _editDiscount      = _orderDetail.DiscountAmount;
            _editIsInstallment = _orderDetail.IsInstallment;
            if (_orderDetail.IsInstallment && _orderDetail.PaymentMethods.Count > 0)
                _editPaymentMethodId = _orderDetail.PaymentMethods[0].PaymentMethodId;
            else
                _editPaymentMethodIds = _orderDetail.PaymentMethods.Select(p => p.PaymentMethodId).ToList();
            _editPmAmounts = _orderDetail.PaymentMethods.ToDictionary(p => p.PaymentMethodId, p => p.Amount);
            _editItems = _orderDetail.Items.Select(i => new EditItemVm
            {
                ProductId   = i.ProductId ?? Guid.Empty,
                ProductName = i.ProductName,
                UnitPrice   = i.UnitPrice,
                Quantity    = i.Quantity
            }).ToList();
            _addProduct = null;
            _addQty = 1;
            _editNotes = _orderDetail.Notes;

            var customerResp = await CustomerService.GetByIdAsync(_orderDetail.CustomerId);
            _customerDetail = customerResp?.Data;
        }
        else
        {
            Snackbar.Add("Erro ao carregar pedido.", Severity.Error);
            _dialogDetails = false;
        }
    }

    private async Task SavePaymentMethodAsync()
    {
        if (_orderDetail == null) return;
        _saving = true;

        List<OrderPaymentInputDto> payments;
        if (_editIsInstallment)
        {
            if (_editPaymentMethodId == Guid.Empty) { _saving = false; return; }
            payments = new List<OrderPaymentInputDto> { new(_editPaymentMethodId, _orderDetail.AmountWithSurchargeTotal) };
        }
        else
        {
            var ids = _editPaymentMethodIds.ToList();
            if (ids.Count == 0) { _saving = false; return; }
            if (ids.Count == 1)
            {
                payments = new List<OrderPaymentInputDto> { new(ids[0], _orderDetail.AmountWithSurchargeTotal) };
            }
            else
            {
                var remaining = _orderDetail.AmountWithSurchargeTotal - _editPmAmounts.Values.Sum();
                if (Math.Abs(remaining) > 0.01m)
                {
                    Snackbar.Add($"Ajuste os valores: falta R$ {remaining:N2} para completar o total.", Severity.Warning);
                    _saving = false;
                    return;
                }
                payments = ids.Select(id => new OrderPaymentInputDto(id, _editPmAmounts.GetValueOrDefault(id, 0m))).ToList();
            }
        }

        var dto = new UpdateOrderPaymentMethodDto(_editIsInstallment, payments);
        var resp = await OrderService.UpdatePaymentMethodAsync(_orderDetail.Id, dto);
        if (resp?.Success == true)
        {
            Snackbar.Add("Forma de pagamento alterada e valores recalculados!", Severity.Success);
            var updated = await OrderService.GetByIdAsync(_orderDetail.Id);
            if (updated?.Success == true)
            {
                _orderDetail = updated.Data;
                _editIsInstallment = _orderDetail!.IsInstallment;
                if (_orderDetail.IsInstallment && _orderDetail.PaymentMethods.Count > 0)
                    _editPaymentMethodId = _orderDetail.PaymentMethods[0].PaymentMethodId;
                else
                    _editPaymentMethodIds = _orderDetail.PaymentMethods.Select(p => p.PaymentMethodId).ToList();
                _editPmAmounts = _orderDetail.PaymentMethods.ToDictionary(p => p.PaymentMethodId, p => p.Amount);
                _editDiscount = _orderDetail.DiscountAmount;
            }
            await _table!.ReloadServerData();
        }
        else Snackbar.Add(resp?.Error ?? "Erro ao alterar forma de pagamento.", Severity.Error);
        _saving = false;
    }

