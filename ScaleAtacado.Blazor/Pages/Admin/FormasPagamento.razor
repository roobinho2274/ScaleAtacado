@page "/admin/formas-pagamento"
@attribute [Authorize(Roles = "Admin")]
@inject PaymentMethodService PaymentMethodService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Formas de Pagamento — ScaleAtacado</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Formas de Pagamento</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNew">
        Nova Forma
    </MudButton>
</div>

<MudTable Items="_paymentMethods" Dense="true" Hover="true" Striped="true" Loading="_loading">
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh Style="text-align:center">Modalidade</MudTh>
        <MudTh Style="text-align:right">Acréscimo (%)</MudTh>
        <MudTh Style="text-align:center">Status</MudTh>
        <MudTh Style="text-align:center">Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nome"><b>@context.Name</b></MudTd>
        <MudTd DataLabel="Modalidade" Style="text-align:center">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsInstallment ? Color.Info : Color.Success)">
                @(context.IsInstallment ? "A Prazo" : "À Vista")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Acréscimo" Style="text-align:right">
            @if (context.SurchargePercentage > 0)
            {
                <MudText Color="Color.Warning">@context.SurchargePercentage.ToString("N2")%</MudText>
            }
            else
            {
                <MudText Color="Color.Success">Sem acréscimo</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Status" Style="text-align:center">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                @(context.IsActive ? "Ativo" : "Inativo")
            </MudChip>
        </MudTd>
        <MudTd Style="text-align:center">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                OnClick="@(() => OpenEdit(context))" />
            @if (context.IsActive)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ToggleOff" Size="Size.Small"
                    Color="Color.Error" OnClick="@(() => DeactivateAsync(context))" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>Nenhuma forma de pagamento cadastrada.</NoRecordsContent>
</MudTable>

<!-- Dialog -->
<MudDialog @bind-Visible="_dialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>@(_editing == null ? "Nova Forma de Pagamento" : "Editar Forma de Pagamento")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_form.Name" Label="Nome" Variant="Variant.Outlined"
            Placeholder="ex: Dinheiro, PIX, Cartão de Crédito"
            FullWidth="true" Class="mb-3" Required="true" />
        <div class="mb-3 d-flex align-center gap-4">
            <MudText Typo="Typo.body2">Modalidade:</MudText>
            <MudToggleGroup T="bool" @bind-Value="_form.IsInstallment" Color="Color.Primary" Outlined="true">
                <MudToggleItem T="bool" Value="false" Text="À Vista" />
                <MudToggleItem T="bool" Value="true" Text="A Prazo" />
            </MudToggleGroup>
        </div>
        <MudNumericField @bind-Value="_form.SurchargePercentage" Label="Acréscimo (%)"
            Variant="Variant.Outlined" FullWidth="true" Min="0m" Format="N2"
            HelperText="0 = sem acréscimo (ex: 2,50 para 2,5%)" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogOpen = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            OnClick="SaveAsync" Disabled="_saving">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<PaymentMethodResponseDto> _paymentMethods = new();
    private bool _loading;
    private bool _dialogOpen;
    private bool _saving;
    private PaymentMethodResponseDto? _editing;
    private FormVm _form = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var resp = await PaymentMethodService.GetAllAsync();
        _paymentMethods = resp?.Data?.ToList() ?? new();
        _loading = false;
    }

    private void OpenNew()
    {
        _editing = null;
        _form = new FormVm();
        _dialogOpen = true;
    }

    private void OpenEdit(PaymentMethodResponseDto f)
    {
        _editing = f;
        _form = new FormVm
        {
            Name = f.Name,
            IsInstallment = f.IsInstallment,
            SurchargePercentage = f.SurchargePercentage
        };
        _dialogOpen = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name)) return;
        _saving = true;

        if (_editing == null)
        {
            var dto = new CreatePaymentMethodDto(_form.Name, _form.IsInstallment, _form.SurchargePercentage);
            var resp = await PaymentMethodService.CreateAsync(dto);
            if (resp?.Success == true)
            {
                Snackbar.Add("Forma de pagamento criada!", Severity.Success);
                _dialogOpen = false;
                await LoadAsync();
            }
            else Snackbar.Add(resp?.Error ?? "Erro ao criar.", Severity.Error);
        }
        else
        {
            var dto = new UpdatePaymentMethodDto(_form.Name, _form.IsInstallment, _form.SurchargePercentage, true);
            var resp = await PaymentMethodService.UpdateAsync(_editing.Id, dto);
            if (resp?.Success == true)
            {
                Snackbar.Add("Forma de pagamento atualizada!", Severity.Success);
                _dialogOpen = false;
                await LoadAsync();
            }
            else Snackbar.Add(resp?.Error ?? "Erro ao atualizar.", Severity.Error);
        }

        _saving = false;
    }

    private async Task DeactivateAsync(PaymentMethodResponseDto f)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Desativar forma de pagamento",
            $"Deseja realmente desativar \"{f.Name}\"?",
            yesText: "Desativar", cancelText: "Cancelar");
        if (confirmed != true) return;

        var resp = await PaymentMethodService.DeactivateAsync(f.Id);
        if (resp?.Success == true)
        {
            Snackbar.Add("Forma de pagamento desativada.", Severity.Info);
            await LoadAsync();
        }
        else Snackbar.Add(resp?.Error ?? "Erro.", Severity.Error);
    }

    private class FormVm
    {
        public string Name { get; set; } = "";
        public bool IsInstallment { get; set; }
        public decimal SurchargePercentage { get; set; }
    }
}
