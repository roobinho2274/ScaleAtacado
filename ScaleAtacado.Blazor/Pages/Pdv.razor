@page "/pdv"
@attribute [Authorize]
@inject CustomerService CustomerService
@inject ProductService ProductService
@inject CategoryService CategoryService
@inject PaymentMethodService PaymentMethodService
@inject OrderService OrderService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>PDV — ScaleAtacado</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Ponto de Venda</MudText>

<MudGrid>
    <!-- Coluna esquerda: Cliente + Produtos -->
    <MudItem xs="12" md="8">

        <!-- Cliente -->
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3"><b>Cliente</b></MudText>
            <MudGrid>
                <MudItem xs="12" sm="9">
                    <MudAutocomplete T="CustomerResponseDto"
                        Label="Buscar cliente"
                        @bind-Value="_selectedCustomer"
                        SearchFunc="SearchCustomersAsync"
                        ToStringFunc="@(c => c?.LegalName ?? string.Empty)"
                        Variant="Variant.Outlined"
                        Dense="true"
                        FullWidth="true"
                        Clearable="true"
                        Disabled="_finalizing" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                        OnClick="OpenNewCustomer" Style="height:56px"
                        Disabled="_finalizing">
                        + Novo
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Adicionar Produto -->
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3"><b>Adicionar Produto</b></MudText>
            <MudGrid>
                <MudItem xs="12">
                    <MudSelect T="Guid?" Label="Categoria" Value="_selectedCategoryFilter"
                        ValueChanged="@((Guid? v) => { _selectedCategoryFilter = v; _selectedProduct = null; })"
                        Variant="Variant.Outlined" Dense="true" FullWidth="true"
                        Clearable="true" Disabled="_finalizing"
                        Placeholder="Todas as categorias">
                        @foreach (var cat in _categories)
                        {
                            <MudSelectItem T="Guid?" Value="(Guid?)cat.Id">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="9" sm="5">
                    <MudAutocomplete T="ProductResponseDto"
                        Label="Buscar produto"
                        @bind-Value="_selectedProduct"
                        SearchFunc="SearchProductsAsync"
                        ToStringFunc="@(p => p != null ? $"{p.Name} — R$ {p.BaseSalePrice:N2}" : string.Empty)"
                        Variant="Variant.Outlined"
                        FullWidth="true"
                        Clearable="true"
                        Disabled="_finalizing" />
                </MudItem>
                <MudItem xs="3" sm="2" Class="d-flex align-end">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                        OnClick="OpenNewProduct" Style="height:56px"
                        Disabled="_finalizing">
                        + Novo
                    </MudButton>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudNumericField @bind-Value="_quantity" Label="Quantidade"
                        Variant="Variant.Outlined" Min="1" Max="9999"
                        Disabled="_finalizing" />
                </MudItem>
                <MudItem xs="6" sm="2" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                        OnClick="AddItem" Style="height:56px"
                        Disabled="@(_finalizing || _selectedProduct == null)">
                        Adicionar
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Itens do Pedido -->
        <MudPaper Elevation="2">
            <MudTable Items="_items" Dense="true" Hover="true" Striped="true">
                <NoRecordsContent>Nenhum item adicionado.</NoRecordsContent>
                <HeaderContent>
                    <MudTh>Produto</MudTh>
                    <MudTh Style="text-align:right">Preço Unit.</MudTh>
                    <MudTh Style="text-align:center">Qtd</MudTh>
                    <MudTh Style="text-align:right">Total</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Produto">@context.ProductName</MudTd>
                    <MudTd DataLabel="Preço Unit." Style="text-align:right">R$ @context.UnitPrice.ToString("N2")</MudTd>
                    <MudTd DataLabel="Qtd" Style="text-align:center">
                        <MudNumericField Value="context.Quantity" Min="1" Max="9999"
                            Variant="Variant.Text" Style="width:70px;text-align:center"
                            Disabled="_finalizing"
                            ValueChanged="@(EventCallback.Factory.Create<int>(this, v => UpdateQuantity(context, v)))" />
                    </MudTd>
                    <MudTd DataLabel="Total" Style="text-align:right">R$ @context.TotalPrice.ToString("N2")</MudTd>
                    <MudTd Style="text-align:center">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                            Size="Size.Small" OnClick="@(() => RemoveItem(context))"
                            Disabled="_finalizing" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>

    <!-- Coluna direita: Forma de Pagamento + Resumo -->
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Modalidade de Pagamento</b></MudText>

            <!-- Seletor de modalidade -->
            <MudButtonGroup Variant="Variant.Outlined" FullWidth="true" Class="mb-3">
                <MudButton Color="@(!_isInstallment ? Color.Primary : Color.Default)"
                    Variant="@(!_isInstallment ? Variant.Filled : Variant.Outlined)"
                    OnClick="@(() => OnModalityChanged(false))"
                    Disabled="_finalizing" Style="flex:1">
                    À Vista
                </MudButton>
                <MudButton Color="@(_isInstallment ? Color.Primary : Color.Default)"
                    Variant="@(_isInstallment ? Variant.Filled : Variant.Outlined)"
                    OnClick="@(() => OnModalityChanged(true))"
                    Disabled="_finalizing" Style="flex:1">
                    A Prazo
                </MudButton>
            </MudButtonGroup>

            @if (!_isInstallment)
            {
                <MudSelect T="PaymentMethodResponseDto"
                    Label="Formas de Pagamento"
                    MultiSelection="true"
                    SelectedValues="_selectedPMs"
                    SelectedValuesChanged="@((IReadOnlyCollection<PaymentMethodResponseDto> vals) => OnPMsChanged(vals))"
                    ToStringFunc="@(f => f?.Name ?? string.Empty)"
                    Variant="Variant.Outlined" Dense="true" FullWidth="true"
                    Disabled="_finalizing">
                    @foreach (var pm in _filteredPaymentMethods)
                    {
                        <MudSelectItem T="PaymentMethodResponseDto" Value="pm">
                            @pm.Name
                            @if (pm.SurchargePercentage > 0)
                            {
                                <span style="color:var(--mud-palette-warning)"> (+@pm.SurchargePercentage.ToString("N1")%)</span>
                            }
                        </MudSelectItem>
                    }
                </MudSelect>
                @if (_selectedPMs.Count > 1)
                {
                    <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-1 mb-2" Style="display:block">
                        Pagamento dividido entre @_selectedPMs.Count forma(s). Sem acréscimo.
                    </MudText>
                    @foreach (var pm in _selectedPMs)
                    {
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudText Typo="Typo.body2" Style="min-width:80px">@pm.Name:</MudText>
                            <MudNumericField T="decimal"
                                Value="_pmAmounts.GetValueOrDefault(pm.Id)"
                                ValueChanged="@(v => { _pmAmounts[pm.Id] = v; StateHasChanged(); })"
                                Min="0m" Format="N2"
                                Variant="Variant.Outlined" Margin="Margin.Dense"
                                Style="flex:1" Disabled="_finalizing" />
                        </div>
                    }
                    <div class="d-flex justify-space-between mt-1">
                        <MudText Typo="Typo.caption">Restante:</MudText>
                        <MudText Typo="Typo.caption" Color="@(Math.Abs(_finalTotal - _pmAmounts.Values.Sum()) < 0.01m ? Color.Success : Color.Error)">
                            R$ @((_finalTotal - _pmAmounts.Values.Sum()).ToString("N2"))
                        </MudText>
                    </div>
                }
                @if (!_filteredPaymentMethods.Any())
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1" Style="display:block">
                        Nenhuma forma de pagamento à vista cadastrada.
                    </MudText>
                }
            }
            else
            {
                <MudSelect T="PaymentMethodResponseDto"
                    Label="Forma de Pagamento (A Prazo)"
                    @bind-Value="_paymentMethodAPrazo"
                    ToStringFunc="@(f => f?.Name ?? string.Empty)"
                    Variant="Variant.Outlined" Dense="true" FullWidth="true"
                    Disabled="_finalizing">
                    @foreach (var pm in _filteredPaymentMethods)
                    {
                        <MudSelectItem T="PaymentMethodResponseDto" Value="pm">
                            @pm.Name
                            @if (pm.SurchargePercentage > 0)
                            {
                                <span style="color:var(--mud-palette-warning)"> (+@pm.SurchargePercentage.ToString("N1")%)</span>
                            }
                        </MudSelectItem>
                    }
                </MudSelect>
                @if (!_filteredPaymentMethods.Any())
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1" Style="display:block">
                        Nenhuma forma de pagamento a prazo cadastrada.
                    </MudText>
                }
            }
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="3">
            <MudText Typo="Typo.subtitle1" Class="mb-3"><b>Resumo</b></MudText>

            <div class="d-flex justify-space-between mb-2">
                <MudText Typo="Typo.body2">Subtotal:</MudText>
                <MudText Typo="Typo.body2">R$ @_subtotal.ToString("N2")</MudText>
            </div>

            @if (_effectiveSurcharge > 0)
            {
                var surchargeAmt = _totalWithSurcharge - _subtotal;
                <div class="d-flex justify-space-between mb-2">
                    <MudText Typo="Typo.body2" Color="Color.Warning">
                        Acréscimo (@_effectiveSurcharge.ToString("N1")%):
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Warning">
                        R$ @surchargeAmt.ToString("N2")
                    </MudText>
                </div>
            }

            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.body2">Desconto:</MudText>
                <MudNumericField @bind-Value="_discount" Min="0m" Format="N2"
                    Variant="Variant.Outlined" Margin="Margin.Dense"
                    Style="width:120px" Placeholder="0,00"
                    Disabled="_finalizing" />
            </div>

            <MudDivider Class="my-2" />
            <div class="d-flex justify-space-between mb-4">
                <MudText Typo="Typo.h6"><b>Total:</b></MudText>
                <MudText Typo="Typo.h6" Color="Color.Primary"><b>R$ @_finalTotal.ToString("N2")</b></MudText>
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                Size="Size.Large" OnClick="FinalizeOrderAsync"
                Disabled="@(_finalizing || _items.Count == 0 || _selectedCustomer == null || !_hasPaymentSelected)">
                @if (_finalizing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                FINALIZAR PEDIDO
            </MudButton>

            <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                Class="mt-2" OnClick="ClearOrder" Disabled="_finalizing">
                Limpar
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Dialog: Novo Cliente -->
<MudDialog @bind-Visible="_customerDialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>Novo Cliente</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_newCustomerName" Label="Nome / Razão Social"
            Placeholder="ex: João da Silva ou Mercado Bom Preço Ltda"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true"
            Error="@(_errorName != null)" ErrorText="@_errorName" />
        <MudTextField @bind-Value="_newCustomerTaxId" Label="CPF / CNPJ"
            Placeholder="000.000.000-00 ou 00.000.000/0000-00"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
            HelperText="Apenas números — 11 dígitos (CPF) ou 14 dígitos (CNPJ)"
            Error="@(_errorTaxId != null)" ErrorText="@_errorTaxId" />
        <MudTextField @bind-Value="_newCustomerPhone" Label="Telefone"
            Placeholder="(00) 9 0000-0000"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
            Error="@(_errorPhone != null)" ErrorText="@_errorPhone" />
        <MudTextField @bind-Value="_newCustomerAddress" Label="Endereço"
            Placeholder="Rua, número, bairro, cidade — UF"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
            Error="@(_errorAddress != null)" ErrorText="@_errorAddress" />
        <MudTextField @bind-Value="_newCustomerNotes" Label="Observações"
            Placeholder="Informações adicionais sobre o cliente (opcional)"
            Variant="Variant.Outlined" FullWidth="true" Lines="2"
            Error="@(_errorNotes != null)" ErrorText="@_errorNotes" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _customerDialogOpen = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            OnClick="SaveNewCustomerAsync" Disabled="_savingCustomer">
            @if (_savingCustomer) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog: Novo Produto (cadastro rápido via PDV) -->
<MudDialog @bind-Visible="_productDialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>Novo Produto</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_newProductName" Label="Nome"
            Placeholder="ex: Coca-Cola 2L, Arroz 5kg"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
            Error="@(_errProductName != null)" ErrorText="@_errProductName" />

        <MudSelect T="Guid?" Label="Categoria" @bind-Value="_newProductCategoryId"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
            Placeholder="Selecione uma categoria"
            Error="@(_errProductCategory != null)" ErrorText="@_errProductCategory">
            @foreach (var cat in _categories)
            {
                <MudSelectItem T="Guid?" Value="(Guid?)cat.Id">@cat.Name</MudSelectItem>
            }
        </MudSelect>

        @if (_isAdmin)
        {
            <MudNumericField @bind-Value="_newProductPackageQty" Label="Qtd no Pacote"
                Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Min="1" Max="9999"
                HelperText="Número de itens no pacote (ex: 12 para um fardo de 12)" />
            <MudGrid>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_newProductCost" Label="Custo por Item (R$)"
                        Variant="Variant.Outlined" Min="0m" Format="N2"
                        Error="@(_errProductPrice != null)" ErrorText="@_errProductPrice" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_newProductMargin" Label="Margem (%)"
                        Variant="Variant.Outlined" Min="0m" Max="1000m" Format="N2" />
                </MudItem>
            </MudGrid>
            @if (_newProductCost > 0)
            {
                var precoItem = _newProductCost * (1 + _newProductMargin / 100m);
                var precoPacote = _newProductPackageQty * precoItem;
                <MudText Typo="Typo.caption" Color="Color.Primary" Class="mt-2" Style="display:block">
                    Preço do pacote: <b>R$ @precoPacote.ToString("N2")</b>
                    @if (_newProductPackageQty > 1)
                    {
                        <text> (@_newProductPackageQty × R$ @precoItem.ToString("N2")/item)</text>
                    }
                </MudText>
            }
        }
        else
        {
            <MudNumericField @bind-Value="_newProductPackageQty" Label="Qtd no Pacote"
                Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Min="1" Max="9999"
                HelperText="Número de itens que compõem este pacote (ex: 12 para um fardo de 12)" />
            <MudNumericField @bind-Value="_newProductSalePrice" Label="Preço por Item (R$)"
                Variant="Variant.Outlined" FullWidth="true" Min="0m" Format="N2"
                Error="@(_errProductPrice != null)" ErrorText="@_errProductPrice" />
            @if (_newProductSalePrice > 0)
            {
                var precoPacote = _newProductPackageQty * _newProductSalePrice;
                <MudText Typo="Typo.caption" Color="Color.Primary" Class="mt-2" Style="display:block">
                    Preço do pacote: <b>R$ @precoPacote.ToString("N2")</b>
                    @if (_newProductPackageQty > 1)
                    {
                        <text> (@_newProductPackageQty × R$ @_newProductSalePrice.ToString("N2")/item)</text>
                    }
                </MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _productDialogOpen = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            OnClick="SaveNewProductAsync" Disabled="_savingProduct">
            @if (_savingProduct) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private CustomerResponseDto? _selectedCustomer;
    private ProductResponseDto? _selectedProduct;
    private bool _isInstallment = false;
    private IReadOnlyCollection<PaymentMethodResponseDto> _selectedPMs = Array.Empty<PaymentMethodResponseDto>();
    private PaymentMethodResponseDto? _paymentMethodAPrazo;
    private Dictionary<Guid, decimal> _pmAmounts = new();
    private int _quantity = 1;
    private decimal _discount = 0m;
    private bool _finalizing;
    private bool _isAdmin;

    // ── Novo Cliente ──────────────────────────────────────────────────────────
    private bool _customerDialogOpen;
    private bool _savingCustomer;
    private string _newCustomerName    = "";
    private string _newCustomerTaxId   = "";
    private string _newCustomerPhone   = "";
    private string _newCustomerAddress = "";
    private string _newCustomerNotes   = "";
    private string? _errorName;
    private string? _errorTaxId;
    private string? _errorPhone;
    private string? _errorAddress;
    private string? _errorNotes;

    // ── Novo Produto (PDV) ────────────────────────────────────────────────────
    private bool _productDialogOpen;
    private bool _savingProduct;
    private List<CategoryResponseDto> _categories = new();
    private Guid? _selectedCategoryFilter;
    private string _newProductName = "";
    private Guid? _newProductCategoryId;
    private int _newProductPackageQty = 1;
    private decimal _newProductCost;
    private decimal _newProductMargin;
    private decimal _newProductSalePrice;
    private string? _errProductName;
    private string? _errProductCategory;
    private string? _errProductPrice;

    // ── Carrinho / Dados ──────────────────────────────────────────────────────
    private List<OrderItemVm> _items = new();
    private List<ProductResponseDto> _products = new();
    private List<PaymentMethodResponseDto> _paymentMethods = new();

    private IEnumerable<PaymentMethodResponseDto> _filteredPaymentMethods =>
        _paymentMethods.Where(p => p.IsInstallment == _isInstallment);

    private decimal _effectiveSurcharge
    {
        get
        {
            if (_isInstallment)
                return _paymentMethodAPrazo?.SurchargePercentage ?? 0m;
            if (_selectedPMs.Count == 1)
                return _selectedPMs.First().SurchargePercentage;
            return 0m;
        }
    }

    private bool _hasPaymentSelected => _isInstallment
        ? _paymentMethodAPrazo != null
        : _selectedPMs.Count > 0;

    private decimal _subtotal => _items.Sum(i => i.TotalPrice);
    private decimal _totalWithSurcharge => _subtotal * (1 + _effectiveSurcharge / 100m);
    private decimal _finalTotal => Math.Max(0m, _totalWithSurcharge - _discount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("Admin");

        var prodResp = await ProductService.GetAllActiveAsync();
        if (prodResp?.Success == true && prodResp.Data != null)
            _products = prodResp.Data.ToList();

        var pmResp = await PaymentMethodService.GetAllAsync(onlyActive: true);
        if (pmResp?.Success == true && pmResp.Data != null)
            _paymentMethods = pmResp.Data.ToList();

        var catResp = await CategoryService.GetAllAsync();
        if (catResp?.Success == true && catResp.Data != null)
            _categories = catResp.Data.ToList();
    }

    private async Task<IEnumerable<CustomerResponseDto>> SearchCustomersAsync(string term, CancellationToken ct)
    {
        var resp = await CustomerService.SearchAsync(term);
        return resp?.Data ?? Enumerable.Empty<CustomerResponseDto>();
    }

    private Task<IEnumerable<ProductResponseDto>> SearchProductsAsync(string term, CancellationToken ct)
    {
        var source = _selectedCategoryFilter.HasValue
            ? _products.Where(p => p.CategoryId == _selectedCategoryFilter.Value)
            : _products;

        var result = string.IsNullOrWhiteSpace(term)
            ? source
            : source.Where(p =>
                p.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (p.Code?.Contains(term, StringComparison.OrdinalIgnoreCase) == true));

        return Task.FromResult<IEnumerable<ProductResponseDto>>(result);
    }

    private void OnModalityChanged(bool installment)
    {
        _isInstallment = installment;
        _selectedPMs = Array.Empty<PaymentMethodResponseDto>();
        _paymentMethodAPrazo = null;
        _pmAmounts.Clear();
    }

    private void OnPMsChanged(IReadOnlyCollection<PaymentMethodResponseDto> vals)
    {
        _selectedPMs = vals;
        var idSet = vals.Select(p => p.Id).ToHashSet();
        foreach (var id in _pmAmounts.Keys.ToList())
            if (!idSet.Contains(id)) _pmAmounts.Remove(id);
        foreach (var pm in vals)
            if (!_pmAmounts.ContainsKey(pm.Id)) _pmAmounts[pm.Id] = 0m;
        StateHasChanged();
    }

    private void AddItem()
    {
        if (_selectedProduct == null) return;

        var existing = _items.FirstOrDefault(i => i.ProductId == _selectedProduct.Id);
        if (existing != null)
        {
            existing.Quantity += _quantity;
        }
        else
        {
            _items.Add(new OrderItemVm
            {
                ProductId   = _selectedProduct.Id,
                ProductName = _selectedProduct.Name,
                UnitPrice   = _selectedProduct.BaseSalePrice,
                Quantity    = _quantity
            });
        }

        _selectedProduct = null;
        _quantity = 1;
    }

    private void UpdateQuantity(OrderItemVm item, int newQuantity)
    {
        item.Quantity = newQuantity;
        StateHasChanged();
    }

    private void RemoveItem(OrderItemVm item) => _items.Remove(item);

    private void ClearOrder()
    {
        _items.Clear();
        _selectedCustomer = null;
        _paymentMethodAPrazo = null;
        _selectedPMs = Array.Empty<PaymentMethodResponseDto>();
        _pmAmounts.Clear();
        _isInstallment = false;
        _quantity = 1;
        _discount = 0m;
    }

    private async Task FinalizeOrderAsync()
    {
        if (_selectedCustomer == null || !_hasPaymentSelected || _items.Count == 0) return;

        _finalizing = true;

        List<OrderPaymentInputDto> payments;
        if (_isInstallment)
        {
            payments = new List<OrderPaymentInputDto> { new(_paymentMethodAPrazo!.Id, _finalTotal) };
        }
        else if (_selectedPMs.Count == 1)
        {
            payments = new List<OrderPaymentInputDto> { new(_selectedPMs.First().Id, _finalTotal) };
        }
        else
        {
            var remaining = _finalTotal - _pmAmounts.Values.Sum();
            if (Math.Abs(remaining) > 0.01m)
            {
                Snackbar.Add($"Ajuste os valores: falta R$ {remaining:N2} para completar o total.", Severity.Warning);
                _finalizing = false;
                return;
            }
            payments = _selectedPMs.Select(pm => new OrderPaymentInputDto(pm.Id, _pmAmounts.GetValueOrDefault(pm.Id, 0m))).ToList();
        }

        var dto = new CreateOrderDto(
            _selectedCustomer.Id,
            _isInstallment,
            payments,
            _items.Select(i => new CreateOrderItemDto(i.ProductId, i.Quantity)).ToList(),
            _discount
        );

        var resp = await OrderService.CreateAsync(dto);
        if (resp?.Success == true && resp.Data != null)
        {
            var finalize = await OrderService.FinalizeAsync(resp.Data.Id);
            if (finalize?.Success == true)
            {
                Snackbar.Add($"Pedido #{resp.Data.OrderNumber} criado com sucesso!", Severity.Success);
                ClearOrder();
            }
            else
            {
                Snackbar.Add(finalize?.Error ?? "Erro ao finalizar pedido.", Severity.Error);
            }
        }
        else
        {
            Snackbar.Add(resp?.Error ?? "Erro ao criar pedido.", Severity.Error);
        }

        _finalizing = false;
    }

    // ── Novo Cliente ──────────────────────────────────────────────────────────

    private void OpenNewCustomer()
    {
        _newCustomerName    = "";
        _newCustomerTaxId   = "";
        _newCustomerPhone   = "";
        _newCustomerAddress = "";
        _newCustomerNotes   = "";
        _errorName = _errorTaxId = _errorPhone = _errorAddress = _errorNotes = null;
        _customerDialogOpen = true;
    }

    private bool ValidateNewCustomer()
    {
        _errorName = _errorTaxId = _errorPhone = _errorAddress = _errorNotes = null;

        if (string.IsNullOrWhiteSpace(_newCustomerName))
            _errorName = "Nome/Razão Social é obrigatório.";
        else if (_newCustomerName.Trim().Length > 200)
            _errorName = "Nome deve ter no máximo 200 caracteres.";

        if (string.IsNullOrWhiteSpace(_newCustomerTaxId))
        {
            _errorTaxId = "CPF/CNPJ é obrigatório.";
        }
        else
        {
            var digits = new string(_newCustomerTaxId.Where(char.IsDigit).ToArray());
            if (digits.Length == 0)
                _errorTaxId = "Informe apenas os números do CPF (11 dígitos) ou CNPJ (14 dígitos).";
            else if (digits.Length != 11 && digits.Length != 14)
                _errorTaxId = $"Documento inválido: {digits.Length} dígito(s) informado(s). CPF precisa de 11, CNPJ de 14.";
        }

        if (string.IsNullOrWhiteSpace(_newCustomerPhone))
            _errorPhone = "Telefone é obrigatório.";
        else if (_newCustomerPhone.Trim().Length > 20)
            _errorPhone = "Telefone deve ter no máximo 20 caracteres.";

        if (string.IsNullOrWhiteSpace(_newCustomerAddress))
            _errorAddress = "Endereço é obrigatório.";
        else if (_newCustomerAddress.Trim().Length > 300)
            _errorAddress = "Endereço deve ter no máximo 300 caracteres.";

        if (!string.IsNullOrEmpty(_newCustomerNotes) && _newCustomerNotes.Length > 500)
            _errorNotes = "Observações deve ter no máximo 500 caracteres.";

        return _errorName == null && _errorTaxId == null && _errorPhone == null
            && _errorAddress == null && _errorNotes == null;
    }

    private async Task SaveNewCustomerAsync()
    {
        if (!ValidateNewCustomer()) return;

        _savingCustomer = true;

        var dto = new CreateCustomerDto(
            _newCustomerName.Trim(),
            _newCustomerTaxId.Trim(),
            _newCustomerAddress.Trim(),
            _newCustomerPhone.Trim(),
            string.IsNullOrWhiteSpace(_newCustomerNotes) ? null : _newCustomerNotes.Trim());

        var resp = await CustomerService.CreateAsync(dto);
        if (resp?.Success == true && resp.Data != null)
        {
            _selectedCustomer = resp.Data;
            _customerDialogOpen = false;
            Snackbar.Add("Cliente cadastrado!", Severity.Success);
        }
        else
        {
            var msg = resp?.Error ?? "Erro ao cadastrar cliente. Verifique os dados e tente novamente.";
            if (msg.Contains("CPF/CNPJ", StringComparison.OrdinalIgnoreCase))
                _errorTaxId = msg;
            else
                Snackbar.Add(msg, Severity.Error);
        }

        _savingCustomer = false;
    }

    // ── Novo Produto (PDV) ────────────────────────────────────────────────────

    private void OpenNewProduct()
    {
        _newProductName = "";
        _newProductCategoryId = null;
        _newProductPackageQty = 1;
        _newProductCost = 0;
        _newProductMargin = 0;
        _newProductSalePrice = 0;
        _errProductName = _errProductCategory = _errProductPrice = null;
        _productDialogOpen = true;
    }

    private async Task SaveNewProductAsync()
    {
        _errProductName = _errProductCategory = _errProductPrice = null;

        if (string.IsNullOrWhiteSpace(_newProductName))
            _errProductName = "Nome é obrigatório.";
        else if (_newProductName.Trim().Length > 100)
            _errProductName = "Nome deve ter no máximo 100 caracteres.";

        if (!_newProductCategoryId.HasValue)
            _errProductCategory = "Selecione uma categoria.";

        if (_isAdmin && _newProductCost <= 0)
            _errProductPrice = "Custo deve ser maior que zero.";
        else if (!_isAdmin && _newProductSalePrice <= 0)
            _errProductPrice = "Preço por item deve ser maior que zero.";

        if (_errProductName != null || _errProductCategory != null || _errProductPrice != null)
            return;

        _savingProduct = true;

        var (cost, margin, pkgQty) = _isAdmin
            ? (_newProductCost, _newProductMargin, _newProductPackageQty)
            : (_newProductSalePrice, 0m, _newProductPackageQty);

        var dto = new CreateProductDto(
            Guid.Empty,
            "",
            _newProductName.Trim(),
            cost,
            margin,
            _newProductCategoryId!.Value,
            pkgQty
        );

        var resp = await ProductService.CreateAsync(dto);
        if (resp?.Success == true && resp.Data != null)
        {
            _products.Add(resp.Data);
            _selectedProduct = resp.Data;
            _productDialogOpen = false;
            Snackbar.Add("Produto criado!", Severity.Success);
        }
        else
        {
            Snackbar.Add(resp?.Error ?? "Erro ao criar produto.", Severity.Error);
        }

        _savingProduct = false;
    }

    private class OrderItemVm
    {
        public Guid ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal UnitPrice { get; set; }
        public int Quantity { get; set; } = 1;
        public decimal TotalPrice => UnitPrice * Quantity;
    }
}
