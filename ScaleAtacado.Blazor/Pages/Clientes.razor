@page "/clientes"
@attribute [Authorize]
@inject CustomerService CustomerService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Clientes — ScaleAtacado</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Clientes</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenNew">
        Novo Cliente
    </MudButton>
</div>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_searchTerm" Label="Buscar por nome ou documento"
                Placeholder="Nome, CPF/CNPJ ou telefone..."
                Variant="Variant.Outlined"
                Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                OnKeyUp="OnKeyUp" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                OnClick="LoadAsync" StartIcon="@Icons.Material.Filled.Search">
                Buscar
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="_customers" Dense="true" Hover="true" Striped="true" Loading="_loading">
    <HeaderContent>
        <MudTh>Nome / Razão Social</MudTh>
        <MudTh>Documento</MudTh>
        <MudTh>Telefone</MudTh>
        <MudTh>Endereço</MudTh>
        <MudTh Style="text-align:center">Status</MudTh>
        <MudTh Style="text-align:center">Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nome">@context.LegalName</MudTd>
        <MudTd DataLabel="Documento">@context.TaxId</MudTd>
        <MudTd DataLabel="Telefone">@context.Phone</MudTd>
        <MudTd DataLabel="Endereço">@context.Address</MudTd>
        <MudTd DataLabel="Status" Style="text-align:center">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                @(context.IsActive ? "Ativo" : "Inativo")
            </MudChip>
        </MudTd>
        <MudTd Style="text-align:center">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                OnClick="@(() => OpenEdit(context))" />
            @if (context.IsActive)
            {
                <MudIconButton Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small"
                    Color="Color.Error" OnClick="@(() => DeactivateAsync(context))" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>Nenhum cliente encontrado.</NoRecordsContent>
</MudTable>

<!-- Dialog: Criar / Editar -->
<MudDialog @bind-Visible="_dialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>@(_editing == null ? "Novo Cliente" : "Editar Cliente")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_form.LegalName" Label="Nome / Razão Social"
            Placeholder="ex: João da Silva ou Mercado Bom Preço Ltda"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true"
            Error="@(_nameError != null)" ErrorText="@_nameError" />
        <MudTextField @bind-Value="_form.TaxId" Label="CPF / CNPJ"
            Placeholder="000.000.000-00 ou 00.000.000/0000-00"
            HelperText="Apenas números — 11 dígitos (CPF) ou 14 dígitos (CNPJ)"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" />
        <MudTextField @bind-Value="_form.Phone" Label="Telefone"
            Placeholder="(00) 9 0000-0000"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" />
        <MudTextField @bind-Value="_form.Address" Label="Endereço"
            Placeholder="Rua, número, bairro, cidade — UF"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" />
        <MudTextField @bind-Value="_form.Notes" Label="Observações"
            Placeholder="Informações adicionais sobre o cliente (opcional)"
            Variant="Variant.Outlined" FullWidth="true" Lines="2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogOpen = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            OnClick="SaveAsync" Disabled="_saving">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<CustomerResponseDto> _customers = new();
    private string _searchTerm = "";
    private bool _loading;
    private bool _dialogOpen;
    private bool _saving;
    private CustomerResponseDto? _editing;
    private FormVm _form = new();
    private string? _nameError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var resp = await CustomerService.SearchAsync(_searchTerm);
        _customers = resp?.Data?.ToList() ?? new();
        _loading = false;
    }

    private void OpenNew()
    {
        _editing = null;
        _form = new FormVm();
        _dialogOpen = true;
    }

    private void OpenEdit(CustomerResponseDto c)
    {
        _editing = c;
        _form = new FormVm
        {
            LegalName = c.LegalName,
            TaxId = c.TaxId,
            Phone = c.Phone,
            Address = c.Address,
            Notes = c.Notes ?? ""
        };
        _dialogOpen = true;
    }

    private async Task SaveAsync()
    {
        _nameError = null;
        if (string.IsNullOrWhiteSpace(_form.LegalName) || _form.LegalName.Trim().Length < 2)
        {
            _nameError = "Nome deve ter pelo menos 2 caracteres.";
            return;
        }
        _saving = true;
        try
        {
        if (_editing == null)
        {
            var dto = new CreateCustomerDto(_form.LegalName, _form.TaxId, _form.Address, _form.Phone, _form.Notes);
            var resp = await CustomerService.CreateAsync(dto);
            if (resp?.Success == true)
            {
                Snackbar.Add("Cliente criado com sucesso!", Severity.Success);
                _dialogOpen = false;
                await LoadAsync();
            }
            else Snackbar.Add(resp?.Error ?? "Erro ao criar.", Severity.Error);
        }
        else
        {
            var dto = new UpdateCustomerDto(_form.LegalName, _form.TaxId, _form.Address, _form.Phone, _form.Notes, true);
            var resp = await CustomerService.UpdateAsync(_editing.Id, dto);
            if (resp?.Success == true)
            {
                Snackbar.Add("Cliente atualizado!", Severity.Success);
                _dialogOpen = false;
                await LoadAsync();
            }
            else Snackbar.Add(resp?.Error ?? "Erro ao atualizar.", Severity.Error);
        }
        }
        catch
        {
            Snackbar.Add("Erro ao conectar ao servidor.", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeactivateAsync(CustomerResponseDto c)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Desativar cliente",
            $"Deseja realmente desativar \"{c.LegalName}\"?",
            yesText: "Desativar", cancelText: "Cancelar");
        if (confirmed != true) return;

        var resp = await CustomerService.DeactivateAsync(c.Id);
        if (resp?.Success == true)
        {
            Snackbar.Add("Cliente desativado.", Severity.Info);
            await LoadAsync();
        }
        else Snackbar.Add(resp?.Error ?? "Erro.", Severity.Error);
    }

    private class FormVm
    {
        public string LegalName { get; set; } = "";
        public string TaxId { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Address { get; set; } = "";
        public string? Notes { get; set; }
    }
}
