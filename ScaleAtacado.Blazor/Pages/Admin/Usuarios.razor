@page "/admin/usuarios"
@attribute [Authorize(Roles = "Admin")]
@inject UserService UserService
@inject ISnackbar Snackbar

<PageTitle>Usuários — ScaleAtacado</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Usuários</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenNew">
        Novo Usuário
    </MudButton>
</div>

<MudTable Items="_users" Dense="true" Hover="true" Striped="true" Loading="_loading">
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>E-mail</MudTh>
        <MudTh Style="text-align:center">Código</MudTh>
        <MudTh Style="text-align:center">Perfil</MudTh>
        <MudTh Style="text-align:center">Status</MudTh>
        <MudTh Style="text-align:center">Cadastro</MudTh>
        <MudTh Style="text-align:center">Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nome"><b>@context.FullName</b></MudTd>
        <MudTd DataLabel="E-mail">@context.Email</MudTd>
        <MudTd DataLabel="Código" Style="text-align:center">
            @if (context.UserCode > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                    Style="font-family:monospace;font-weight:bold;letter-spacing:2px">
                    @context.UserCode.ToString("D4")
                </MudChip>
            }
            else
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                    StartIcon="@Icons.Material.Filled.Tag"
                    OnClick="@(() => GenerateCodeAsync(context))">
                    Gerar
                </MudButton>
            }
        </MudTd>
        <MudTd DataLabel="Perfil" Style="text-align:center">
            <MudChip T="string" Size="Size.Small"
                Color="@(context.Profile == UserProfile.Admin ? Color.Error : Color.Info)">
                @(context.Profile == UserProfile.Admin ? "Admin" : "Atendente")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Status" Style="text-align:center">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                @(context.IsActive ? "Ativo" : "Inativo")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Cadastro" Style="text-align:center">@context.CreatedAt.ToString("dd/MM/yyyy")</MudTd>
        <MudTd Style="text-align:center">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                title="Editar dados"
                OnClick="@(() => OpenEdit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small"
                title="Alterar senha"
                Color="Color.Warning"
                OnClick="@(() => OpenChangePassword(context))" />
            @if (context.UserCode > 0)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                    title="Gerar novo código"
                    Color="Color.Secondary"
                    OnClick="@(() => GenerateCodeAsync(context))" />
            }
            @if (context.IsActive)
            {
                <MudIconButton Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small"
                    title="Desativar usuário"
                    Color="Color.Error" OnClick="@(() => DeactivateAsync(context))" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>Nenhum usuário encontrado.</NoRecordsContent>
</MudTable>

<!-- Dialog: Criar -->
<MudDialog @bind-Visible="_dialogNew" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>Novo Usuário</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_newForm.FullName" Label="Nome Completo"
            Placeholder="ex: Carlos Oliveira"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true"
            Error="@(_errorNameNew != null)" ErrorText="@_errorNameNew" />
        <MudTextField @bind-Value="_newForm.Email" Label="E-mail" InputType="InputType.Email"
            Placeholder="usuario@empresa.com"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true"
            Error="@(_errorEmail != null)" ErrorText="@_errorEmail" />
        <MudTextField @bind-Value="_newForm.Password" Label="Senha" InputType="InputType.Password"
            Placeholder="Crie uma senha segura"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-2" Required="true"
            Error="@(_errorPassword != null)" ErrorText="@_errorPassword" />
        <MudPaper Class="pa-3 mb-3" Elevation="0" Style="background:var(--mud-palette-background-grey);border-radius:4px">
            <MudText Typo="Typo.caption"><b>Regras da senha:</b></MudText>
            <MudText Typo="Typo.caption" Style="display:block">• Mínimo de 6 caracteres</MudText>
            <MudText Typo="Typo.caption" Style="display:block">• Pelo menos uma letra minúscula (a-z)</MudText>
            <MudText Typo="Typo.caption" Style="display:block">• Pelo menos um número (0-9)</MudText>
        </MudPaper>
        <MudSelect T="UserProfile" Label="Perfil" @bind-Value="_newForm.Profile"
            Variant="Variant.Outlined" FullWidth="true">
            <MudSelectItem T="UserProfile" Value="UserProfile.Attendant">Atendente</MudSelectItem>
            <MudSelectItem T="UserProfile" Value="UserProfile.Admin">Administrador</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogNew = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            OnClick="SaveNewAsync" Disabled="_saving">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Criar
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog: Editar -->
<MudDialog @bind-Visible="_dialogEdit" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>Editar Usuário</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_editForm.FullName" Label="Nome Completo"
            Placeholder="ex: Carlos Oliveira"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true"
            Error="@(_errorNameEdit != null)" ErrorText="@_errorNameEdit" />
        <MudSelect T="UserProfile" Label="Perfil" @bind-Value="_editForm.Profile"
            Variant="Variant.Outlined" FullWidth="true">
            <MudSelectItem T="UserProfile" Value="UserProfile.Attendant">Atendente</MudSelectItem>
            <MudSelectItem T="UserProfile" Value="UserProfile.Admin">Administrador</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogEdit = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            OnClick="SaveEditAsync" Disabled="_saving">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog: Alterar Senha -->
<MudDialog @bind-Visible="_dialogPassword" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        Alterar Senha — @_changingPassword?.FullName
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
            A senha é armazenada criptografada. Nem administradores conseguem ver a senha atual.
        </MudAlert>
        <MudTextField @bind-Value="_passwordForm.NewPassword" Label="Nova Senha" InputType="InputType.Password"
            Placeholder="Crie uma senha segura"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-2" Required="true"
            Error="@(_errorNewPassword != null)" ErrorText="@_errorNewPassword" />
        <MudTextField @bind-Value="_passwordForm.Confirm" Label="Confirmar Nova Senha" InputType="InputType.Password"
            Placeholder="Repita a senha"
            Variant="Variant.Outlined" FullWidth="true" Class="mb-3" Required="true"
            Error="@(_errorConfirm != null)" ErrorText="@_errorConfirm" />
        <MudPaper Class="pa-3" Elevation="0" Style="background:var(--mud-palette-background-grey);border-radius:4px">
            <MudText Typo="Typo.caption"><b>Regras da senha:</b></MudText>
            <MudText Typo="Typo.caption" Style="display:block">• Mínimo de 6 caracteres</MudText>
            <MudText Typo="Typo.caption" Style="display:block">• Pelo menos uma letra minúscula (a-z)</MudText>
            <MudText Typo="Typo.caption" Style="display:block">• Pelo menos um número (0-9)</MudText>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogPassword = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning"
            OnClick="SavePasswordAsync" Disabled="_saving">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Alterar Senha
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<UserResponseDto> _users = new();
    private bool _loading;
    private bool _dialogNew;
    private bool _dialogEdit;
    private bool _dialogPassword;
    private bool _saving;
    private UserResponseDto? _editing;
    private UserResponseDto? _changingPassword;

    private NewVm _newForm = new();
    private EditVm _editForm = new();
    private PasswordVm _passwordForm = new();

    private string? _errorNameNew;
    private string? _errorEmail;
    private string? _errorPassword;
    private string? _errorNameEdit;
    private string? _errorNewPassword;
    private string? _errorConfirm;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var resp = await UserService.GetAllAsync();
        _users = resp?.Data?.ToList() ?? new();
        _loading = false;
    }

    private void OpenNew()
    {
        _newForm = new NewVm();
        _errorNameNew = _errorEmail = _errorPassword = null;
        _dialogNew = true;
    }

    private void OpenEdit(UserResponseDto u)
    {
        _editing = u;
        _editForm = new EditVm { FullName = u.FullName, Profile = u.Profile };
        _errorNameEdit = null;
        _dialogEdit = true;
    }

    private void OpenChangePassword(UserResponseDto u)
    {
        _changingPassword = u;
        _passwordForm = new PasswordVm();
        _errorNewPassword = _errorConfirm = null;
        _dialogPassword = true;
    }

    private bool ValidateNew()
    {
        _errorNameNew = _errorEmail = _errorPassword = null;

        if (string.IsNullOrWhiteSpace(_newForm.FullName))
            _errorNameNew = "Nome completo é obrigatório.";
        else if (_newForm.FullName.Trim().Length > 200)
            _errorNameNew = "Nome deve ter no máximo 200 caracteres.";

        if (string.IsNullOrWhiteSpace(_newForm.Email))
            _errorEmail = "E-mail é obrigatório.";
        else if (!IsValidEmail(_newForm.Email))
            _errorEmail = "E-mail inválido.";

        _errorPassword = ValidatePassword(_newForm.Password);

        return _errorNameNew == null && _errorEmail == null && _errorPassword == null;
    }

    private bool ValidateEdit()
    {
        _errorNameEdit = null;

        if (string.IsNullOrWhiteSpace(_editForm.FullName))
            _errorNameEdit = "Nome completo é obrigatório.";
        else if (_editForm.FullName.Trim().Length > 200)
            _errorNameEdit = "Nome deve ter no máximo 200 caracteres.";

        return _errorNameEdit == null;
    }

    private bool ValidatePasswordChange()
    {
        _errorNewPassword = _errorConfirm = null;

        _errorNewPassword = ValidatePassword(_passwordForm.NewPassword);

        if (string.IsNullOrWhiteSpace(_passwordForm.Confirm))
            _errorConfirm = "Confirmação de senha é obrigatória.";
        else if (_passwordForm.NewPassword != _passwordForm.Confirm)
            _errorConfirm = "As senhas não coincidem.";

        return _errorNewPassword == null && _errorConfirm == null;
    }

    private static string? ValidatePassword(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
            return "Senha é obrigatória.";
        if (password.Length < 6)
            return "Senha deve ter no mínimo 6 caracteres.";
        if (!password.Any(char.IsLower))
            return "Senha deve conter pelo menos uma letra minúscula (a-z).";
        if (!password.Any(char.IsDigit))
            return "Senha deve conter pelo menos um número (0-9).";
        return null;
    }

    private static bool IsValidEmail(string email)
    {
        try { _ = new System.Net.Mail.MailAddress(email); return true; }
        catch { return false; }
    }

    private async Task SaveNewAsync()
    {
        if (!ValidateNew()) return;
        _saving = true;

        var dto = new CreateUserDto(_newForm.FullName.Trim(), _newForm.Email.Trim(), _newForm.Password, _newForm.Profile);
        var resp = await UserService.CreateAsync(dto);
        if (resp?.Success == true)
        {
            var code = resp.Data?.UserCode ?? 0;
            var codeMsg = code > 0 ? $" Código de acesso: {code:D4}" : "";
            Snackbar.Add($"Usuário criado com sucesso!{codeMsg}", Severity.Success, cfg => cfg.VisibleStateDuration = 8000);
            _dialogNew = false;
            await LoadAsync();
        }
        else
        {
            var msg = resp?.Error ?? "Erro ao criar usuário.";
            if (msg.Contains("e-mail", StringComparison.OrdinalIgnoreCase) ||
                msg.Contains("email", StringComparison.OrdinalIgnoreCase) ||
                msg.Contains("DuplicateUserName", StringComparison.OrdinalIgnoreCase))
                _errorEmail = "Este e-mail já está em uso.";
            else
                Snackbar.Add(msg, Severity.Error);
        }

        _saving = false;
    }

    private async Task SaveEditAsync()
    {
        if (!ValidateEdit()) return;
        _saving = true;

        var dto = new UpdateUserDto(_editForm.FullName.Trim(), _editForm.Profile, true);
        var resp = await UserService.UpdateAsync(_editing!.Id, dto);
        if (resp?.Success == true)
        {
            Snackbar.Add("Usuário atualizado!", Severity.Success);
            _dialogEdit = false;
            await LoadAsync();
        }
        else Snackbar.Add(resp?.Error ?? "Erro ao atualizar usuário.", Severity.Error);

        _saving = false;
    }

    private async Task SavePasswordAsync()
    {
        if (!ValidatePasswordChange()) return;
        _saving = true;

        var resp = await UserService.ChangePasswordAsync(_changingPassword!.Id, _passwordForm.NewPassword);
        if (resp?.Success == true)
        {
            Snackbar.Add($"Senha de {_changingPassword.FullName} alterada com sucesso!", Severity.Success);
            _dialogPassword = false;
        }
        else Snackbar.Add(resp?.Error ?? "Erro ao alterar senha.", Severity.Error);

        _saving = false;
    }

    private async Task GenerateCodeAsync(UserResponseDto u)
    {
        var resp = await UserService.RegenerateCodeAsync(u.Id);
        if (resp?.Success == true)
        {
            Snackbar.Add($"Novo código de {u.FullName}: {resp.Data:D4}", Severity.Success, cfg => cfg.VisibleStateDuration = 8000);
            await LoadAsync();
        }
        else Snackbar.Add(resp?.Error ?? "Erro ao gerar código.", Severity.Error);
    }

    private async Task DeactivateAsync(UserResponseDto u)
    {
        var resp = await UserService.DeactivateAsync(u.Id);
        if (resp?.Success == true)
        {
            Snackbar.Add("Usuário desativado.", Severity.Info);
            await LoadAsync();
        }
        else Snackbar.Add(resp?.Error ?? "Erro.", Severity.Error);
    }

    private class NewVm
    {
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public UserProfile Profile { get; set; } = UserProfile.Attendant;
    }

    private class EditVm
    {
        public string FullName { get; set; } = "";
        public UserProfile Profile { get; set; } = UserProfile.Attendant;
    }

    private class PasswordVm
    {
        public string NewPassword { get; set; } = "";
        public string Confirm { get; set; } = "";
    }
}
