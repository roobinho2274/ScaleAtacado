@page "/admin/categorias"
@attribute [Authorize(Roles = "Admin")]
@inject CategoryService CategoryService
@inject ISnackbar Snackbar

<PageTitle>Categorias — ScaleAtacado</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Categorias</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirNovo">
        Nova Categoria
    </MudButton>
</div>

<MudTable Items="_categorias" Dense="true" Hover="true" Striped="true" Loading="_carregando">
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>Descrição</MudTh>
        <MudTh Style="text-align:center">Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nome"><b>@context.Name</b></MudTd>
        <MudTd DataLabel="Descrição">@(context.Description ?? "—")</MudTd>
        <MudTd Style="text-align:center">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                OnClick="@(() => AbrirEdicao(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                Color="Color.Error" OnClick="@(() => ExcluirAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>Nenhuma categoria cadastrada.</NoRecordsContent>
</MudTable>

<!-- Dialog -->
<MudDialog @bind-Visible="_dialogAberto" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>@(_editando == null ? "Nova Categoria" : "Editar Categoria")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_form.Name" Label="Nome" Variant="Variant.Outlined"
            FullWidth="true" Class="mb-3" Required="true" />
        <MudTextField @bind-Value="_form.Description" Label="Descrição" Variant="Variant.Outlined"
            FullWidth="true" Lines="2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogAberto = false)">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            OnClick="SalvarAsync" Disabled="_salvando">
            @if (_salvando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<CategoryResponseDto> _categorias = new();
    private bool _carregando;
    private bool _dialogAberto;
    private bool _salvando;
    private CategoryResponseDto? _editando;
    private FormVm _form = new();

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _carregando = true;
        var resp = await CategoryService.GetAllAsync();
        _categorias = resp?.Data?.ToList() ?? new();
        _carregando = false;
    }

    private void AbrirNovo()
    {
        _editando = null;
        _form = new FormVm();
        _dialogAberto = true;
    }

    private void AbrirEdicao(CategoryResponseDto c)
    {
        _editando = c;
        _form = new FormVm { Name = c.Name, Description = c.Description ?? "" };
        _dialogAberto = true;
    }

    private async Task SalvarAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name)) return;
        _salvando = true;

        if (_editando == null)
        {
            var resp = await CategoryService.CreateAsync(new CreateCategoryDto(_form.Name, _form.Description));
            if (resp?.Success == true)
            {
                Snackbar.Add("Categoria criada!", Severity.Success);
                _dialogAberto = false;
                await CarregarAsync();
            }
            else Snackbar.Add(resp?.Error ?? "Erro ao criar.", Severity.Error);
        }
        else
        {
            var resp = await CategoryService.UpdateAsync(_editando.Id, new UpdateCategoryDto(_form.Name, _form.Description));
            if (resp?.Success == true)
            {
                Snackbar.Add("Categoria atualizada!", Severity.Success);
                _dialogAberto = false;
                await CarregarAsync();
            }
            else Snackbar.Add(resp?.Error ?? "Erro ao atualizar.", Severity.Error);
        }

        _salvando = false;
    }

    private async Task ExcluirAsync(CategoryResponseDto c)
    {
        var resp = await CategoryService.DeleteAsync(c.Id);
        if (resp?.Success == true)
        {
            Snackbar.Add("Categoria excluída.", Severity.Info);
            await CarregarAsync();
        }
        else Snackbar.Add(resp?.Error ?? "Erro ao excluir.", Severity.Error);
    }

    private class FormVm
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
    }
}
