@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject AuthService AuthService
@inject NavigationManager NavManager

<PageTitle>Login — ScaleAtacado</PageTitle>

<!-- Logo -->
<div class="d-flex justify-center mb-3">
    <svg width="64" height="64" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="32" height="32" rx="7" fill="#00897B"/>
        <rect x="5" y="20" width="5" height="8" rx="1.5" fill="white" fill-opacity="0.55"/>
        <rect x="13.5" y="14" width="5" height="14" rx="1.5" fill="white" fill-opacity="0.78"/>
        <rect x="22" y="8" width="5" height="20" rx="1.5" fill="white"/>
        <path d="M24.5 5L27.5 9.5H21.5L24.5 5Z" fill="white"/>
    </svg>
</div>

<MudText Typo="Typo.h5" Align="Align.Center" Class="mb-1"
    Style="font-weight:800;color:#1A237E;letter-spacing:-0.5px">
    SCALE<span style="font-weight:300;color:#546E7A">atacado</span>
</MudText>
<MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mb-6">
    Sistema de Vendas Atacado
</MudText>

<MudTextField @bind-Value="_email" Label="E-mail ou Código (4 dígitos)" InputType="InputType.Text"
    Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
    OnKeyUp="OnKeyUp" />

<MudTextField @bind-Value="_password" Label="Senha"
    InputType="@(_showPassword ? InputType.Text : InputType.Password)"
    Variant="Variant.Outlined" FullWidth="true" Class="mb-4"
    OnKeyUp="OnKeyUp"
    Adornment="Adornment.End"
    AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
    OnAdornmentClick="@(() => _showPassword = !_showPassword)" />

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
}

<MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
    Size="Size.Large" OnClick="LoginAsync" Disabled="_loading">
    @if (_loading)
    {
        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
    }
    ENTRAR NO SISTEMA
</MudButton>

@code {
    private string _email = "";
    private string _password = "";
    private string _error = "";
    private bool _loading;
    private bool _showPassword;

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoginAsync();
    }

    private async Task LoginAsync()
    {
        _loading = true;
        _error = "";

        try
        {
            var result = await AuthService.LoginAsync(_email, _password);

            if (result?.Success == true)
                NavManager.NavigateTo("/pdv");
            else
                _error = result?.Error ?? "Credenciais inválidas.";
        }
        catch
        {
            _error = "Não foi possível conectar ao servidor.";
        }
        finally
        {
            _loading = false;
        }
    }
}
