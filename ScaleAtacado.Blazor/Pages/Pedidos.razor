    private Task<IEnumerable<ProductResponseDto>> SearchProductsForEditAsync(string term, CancellationToken ct)
    {
        var result = string.IsNullOrWhiteSpace(term)
            ? _products
            : _products.Where(p =>
                p.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (p.Code?.Contains(term, StringComparison.OrdinalIgnoreCase) == true)).ToList();
        return Task.FromResult<IEnumerable<ProductResponseDto>>(result);
    }

    private void AddEditItem()
    {
        if (_addProduct == null) return;
        var existing = _editItems.FirstOrDefault(i => i.ProductId == _addProduct.Id);
        if (existing != null)
            existing.Quantity += _addQty;
        else
            _editItems.Add(new EditItemVm
            {
                ProductId   = _addProduct.Id,
                ProductName = _addProduct.Name,
                UnitPrice   = _addProduct.BaseSalePrice,
                Quantity    = _addQty
            });
        _addProduct = null;
        _addQty = 1;
    }

    private async Task SaveItemsAsync()
    {
        if (_orderDetail == null || _editItems.Count == 0) return;
        _saving = true;
        var dto = new UpdateOrderItemsDto(
            _editItems.Select(i => new CreateOrderItemDto(i.ProductId, i.Quantity)).ToList());
        var resp = await OrderService.UpdateItemsAsync(_orderDetail.Id, dto);
        if (resp?.Success == true)
        {
