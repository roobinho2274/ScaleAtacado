# =============================================================
#  ScaleAtacado — Variáveis de ambiente (copie para .env)
#  NUNCA versione o arquivo .env — apenas o .env.example
# =============================================================

# ── Banco de dados ────────────────────────────────────────────
POSTGRES_PASSWORD=TrocaMePorUmaSenhaForte123!

# ── JWT — chave secreta de assinatura dos tokens ─────────────
# Gere uma chave aleatória longa (mínimo 32 chars)
# PowerShell: [System.Convert]::ToBase64String((1..64 | % { [byte](Get-Random -Max 256) }))
JWT_KEY=TrocaMePorUmaChaveRandomicaComMinimo32Caracteres_xxxxxxxxxxx

# ── PrintAgent — chave compartilhada com o agente de impressão
# Deve ser igual ao campo PrintAgent:AgentKey no appsettings.json do PrintAgent
AGENT_KEY=ChaveDoAgenteDeImpressao_TroquePorUmaForte

# ── CORS — origens permitidas (URL que o browser usará) ──────
# Formato: URL1,URL2  (sem espaços)
# Exemplos:
#   http://192.168.1.10          → acesso pela rede local via IP
#   http://servidor.local        → acesso via hostname
#   http://localhost             → acesso local
CORS_ORIGINS=http://localhost,http://192.168.1.10
